--step2

--moving AncillaryRevenueLegDetailHistory

SELECT MasterKey INTO TempMove2
FROM LegSchedule
WHERE DepartureDate >= '2024-01-01'  -- cutoff point
ORDER BY MasterKey
CREATE INDEX IX_TempMove2_Masterkey ON TempMove2(Masterkey);

-- move into new Table with chunks of 50000
DECLARE @BatchSize INT = 50000;
DECLARE @RowsInserted INT = 1;
DECLARE @RowsDeleted INT = 1;
DECLARE @Now varchar(20);

IF OBJECT_ID('tempdb..#Batch') IS NOT NULL
DROP TABLE #Batch;

CREATE TABLE #Batch
(
    Masterkey BIGINT PRIMARY KEY
);

WHILE @RowsDeleted > 0
BEGIN
    BEGIN TRAN;

	TRUNCATE TABLE #Batch;

    INSERT INTO #Batch(Masterkey)
    SELECT TOP (@BatchSize) Masterkey
    FROM TempMove2
    ORDER BY Masterkey;

INSERT INTO [AncillaryRevenueLegDetailHistory_New]
   SELECT 
    [CaptureDate],
    a.[MasterKey],
 	[CategoryCode] ,
	[FareClassLetter],
	[Cnt],
	[Rev], 
	[Currency]
    FROM [AncillaryRevenueLegDetailHistory] a
    JOIN #Batch  ON a.Masterkey = #Batch.Masterkey;

    SET @RowsInserted = @@ROWCOUNT;

    DELETE TempMove2
    FROM TempMove2 
    JOIN #Batch ON TempMove2.Masterkey = #Batch.Masterkey;

	SET @RowsDeleted = @@ROWCOUNT;

    COMMIT;

   SET @Now = CONVERT(varchar(20), GETDATE(), 120);
   RAISERROR ('%s - Inserted rows this batch: %d', 0, 1, @Now, @RowsInserted) WITH NOWAIT;

END


