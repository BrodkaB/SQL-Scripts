
USE [YourDEVDatabase];
GO

SET NOCOUNT ON;

DECLARE @SQL nvarchar(max) = N'';

------------------------------------------------------------
-- 1. USERS
------------------------------------------------------------

SELECT @SQL = @SQL +
    N'CREATE USER ' + QUOTENAME(dp.name) +
    N' FOR LOGIN ' + QUOTENAME(sp.name) + N';' +
    CHAR(13) + CHAR(10)
FROM sys.database_principals dp
JOIN sys.server_principals sp
    ON dp.sid = sp.sid
WHERE dp.type IN ('S', 'U', 'G')
  AND dp.name NOT IN
      ('dbo', 'guest', 'INFORMATION_SCHEMA', 'sys')
  AND dp.name NOT LIKE '##%'
  AND sp.name IS NOT NULL
ORDER BY dp.name;


------------------------------------------------------------
-- 2. USERS WITHOUT LOGIN
------------------------------------------------------------

SELECT @SQL = @SQL +
    CHAR(13) + CHAR(10) +
    N'CREATE USER ' + QUOTENAME(dp.name) + N' WITHOUT LOGIN;' +
    CHAR(13) + CHAR(10)
FROM sys.database_principals dp
WHERE dp.authentication_type = 0
  AND dp.type = 'S'
  AND dp.name NOT IN
      ('dbo', 'guest', 'INFORMATION_SCHEMA', 'sys')
  AND dp.name NOT LIKE '##%'
ORDER BY dp.name;


------------------------------------------------------------
-- 3. DATABASE ROLE MEMBERSHIP
------------------------------------------------------------

SELECT @SQL = @SQL +
    CHAR(13) + CHAR(10) +
    N'ALTER ROLE ' + QUOTENAME(r.name) +
    N' ADD MEMBER ' + QUOTENAME(m.name) + N';' +
    CHAR(13) + CHAR(10)
FROM sys.database_role_members drm
JOIN sys.database_principals r
    ON drm.role_principal_id = r.principal_id
JOIN sys.database_principals m
    ON drm.member_principal_id = m.principal_id
WHERE m.name NOT IN
      ('dbo', 'guest', 'INFORMATION_SCHEMA', 'sys')
ORDER BY r.name, m.name;


------------------------------------------------------------
-- 4. EXPLICIT DATABASE PERMISSIONS
------------------------------------------------------------

SELECT @SQL = @SQL +
    CHAR(13) + CHAR(10) +
    CASE dp.state
        WHEN 'G' THEN
            N'GRANT ' + dp.permission_name +
            CASE
                WHEN dp.class = 1 THEN
                    N' ON OBJECT::' +
                    QUOTENAME(OBJECT_SCHEMA_NAME(dp.major_id)) +
                    N'.' +
                    QUOTENAME(OBJECT_NAME(dp.major_id))
                WHEN dp.class = 3 THEN
                    N' ON SCHEMA::' +
                    QUOTENAME(SCHEMA_NAME(dp.major_id))
                WHEN dp.class = 0 THEN
                    N''
                ELSE
                    N''
            END +
            N' TO ' + QUOTENAME(pr.name) + N';'

        WHEN 'W' THEN
            N'GRANT ' + dp.permission_name +
            CASE
                WHEN dp.class = 1 THEN
                    N' ON OBJECT::' +
                    QUOTENAME(OBJECT_SCHEMA_NAME(dp.major_id)) +
                    N'.' +
                    QUOTENAME(OBJECT_NAME(dp.major_id))
                WHEN dp.class = 3 THEN
                    N' ON SCHEMA::' +
                    QUOTENAME(SCHEMA_NAME(dp.major_id))
                WHEN dp.class = 0 THEN
                    N''
                ELSE
                    N''
            END +
            N' TO ' + QUOTENAME(pr.name) +
            N' WITH GRANT OPTION;'

        WHEN 'D' THEN
            N'DENY ' + dp.permission_name +
            CASE
                WHEN dp.class = 1 THEN
                    N' ON OBJECT::' +
                    QUOTENAME(OBJECT_SCHEMA_NAME(dp.major_id)) +
                    N'.' +
                    QUOTENAME(OBJECT_NAME(dp.major_id))
                WHEN dp.class = 3 THEN
                    N' ON SCHEMA::' +
                    QUOTENAME(SCHEMA_NAME(dp.major_id))
                WHEN dp.class = 0 THEN
                    N''
                ELSE
                    N''
            END +
            N' TO ' + QUOTENAME(pr.name) + N';'
    END +
    CHAR(13) + CHAR(10)
FROM sys.database_permissions dp
JOIN sys.database_principals pr
    ON dp.grantee_principal_id = pr.principal_id
WHERE pr.name NOT IN
      ('dbo', 'guest', 'INFORMATION_SCHEMA', 'sys')
  AND dp.state IN ('G', 'W', 'D')
ORDER BY pr.name, dp.class, dp.major_id, dp.permission_name;


------------------------------------------------------------
-- OUTPUT
------------------------------------------------------------

SELECT @SQL AS GeneratedScript;
