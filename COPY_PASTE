
-- Retrieve recent deadlock graphs from system_health event files.

SELECT
    object_name,
    TRY_CONVERT(
        xml,
        event_data
    ).value(
        '(/event/@timestamp)[1]',
        'datetime2(3)'
    ) AS event_time_utc,
    TRY_CONVERT(xml, event_data) AS event_xml
FROM sys.fn_xe_file_target_read_file(
    N'system_health*.xel',
    NULL,
    NULL,
    NULL
)
WHERE object_name = N'xml_deadlock_report'
ORDER BY event_time_utc DESC;
