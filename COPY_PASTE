USE master;
GO

DECLARE @TargetSizeMB BIGINT;
DECLARE @SQL NVARCHAR(MAX);

SELECT @TargetSizeMB = CEILING(MAX(size) / 128.0)
FROM sys.master_files
WHERE database_id = DB_ID(N'tempdb')
  AND type_desc = N'ROWS';

SELECT @SQL = STRING_AGG(
    CAST(
        N'ALTER DATABASE [tempdb] MODIFY FILE ' +
        N'(NAME = ' + QUOTENAME(name, '''') +
        N', SIZE = ' + CONVERT(NVARCHAR(20), @TargetSizeMB) +
        N'MB);'
        AS NVARCHAR(MAX)
    ),
    CHAR(13) + CHAR(10)
)
FROM sys.master_files
WHERE database_id = DB_ID(N'tempdb')
  AND type_desc = N'ROWS'
  AND size < @TargetSizeMB * 128;

SELECT
    @TargetSizeMB AS TargetSizeMB,
    @SQL AS GeneratedScript;
