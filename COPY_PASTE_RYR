SELECT  
    DATEADD(hour, DATEDIFF(hour, GETUTCDATE(), SYSDATETIME()), 
        xevent.value('(event/@timestamp)[1]', 'datetime2')) AS local_time,
    xevent.value('(event/data[@name="scheduler_id"]/value)[1]', 'int') AS scheduler_id,
    xevent.value('(event/data[@name="worker_address"]/value)[1]', 'varchar(50)') AS worker,
    xevent.value('(event/data[@name="process_utilization"]/value)[1]', 'int') AS cpu,
    xevent.value('(event/data[@name="sql_text"]/value)[1]', 'nvarchar(max)') AS sql_text
FROM (
    SELECT CAST(event_data AS XML) AS xevent
    FROM sys.fn_xe_file_target_read_file(
        'system_health*.xel', NULL, NULL, NULL)
) t
WHERE xevent.value('(event/@name)[1]', 'varchar(100)')
    = 'scheduler_monitor_non_yielding_ring_buffer_recorded'
ORDER BY local_time DESC;


CREATE EVENT SESSION [HANG_CAPTURE] ON SERVER
ADD EVENT sqlos.scheduler_monitor_non_yielding_ring_buffer_recorded,
ADD EVENT sqlos.wait_info(
    ACTION(sqlserver.sql_text,sqlserver.session_id,sqlserver.client_app_name)
    WHERE duration > 5000),
ADD EVENT sqlserver.error_reported
ADD TARGET package0.event_file(
    SET filename='D:\XE\hang_capture.xel'
)
WITH (STARTUP_STATE=ON);
GO

SELECT j.name AS job_name, 
       ja.start_execution_date AS StartTime,
	   COALESCE(CONVERT(VARCHAR(5),ABS(DATEDIFF(DAY,(GETDATE()-ja.start_execution_date),'1900-01-01'))) + ' '
               +CONVERT(VARCHAR(10),(GETDATE()-ja.start_execution_date),108),'00 00:00:00') AS [Duration] 
FROM msdb.dbo.sysjobactivity ja 
LEFT JOIN msdb.dbo.sysjobhistory jh ON ja.job_history_id = jh.instance_id
JOIN msdb.dbo.sysjobs j ON ja.job_id = j.job_id
WHERE ja.session_id = (SELECT TOP 1 session_id FROM msdb.dbo.syssessions ORDER BY session_id DESC)
  AND start_execution_date is not null
  AND stop_execution_date is null;
