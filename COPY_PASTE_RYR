USE RLL;
GO

SELECT
    sch.name AS schema_name,
    tbl.name AS table_name,
    idx.index_id,
    idx.name AS index_name,
    idx.type_desc,
    ips.page_count,
    CAST(ips.page_count * 8.0 / 1024 AS DECIMAL(18,2)) AS size_mb,
    CAST(ips.page_count * 8.0 / 1024 / 1024 AS DECIMAL(18,2)) AS size_gb,
    CAST(ips.avg_fragmentation_in_percent AS DECIMAL(10,2)) AS fragmentation_pct,
    CAST(ips.avg_page_space_used_in_percent AS DECIMAL(10,2)) AS page_space_used_pct,
    ips.record_count,
    ips.forwarded_record_count
FROM sys.dm_db_index_physical_stats
(
    DB_ID(),
    NULL,
    NULL,
    NULL,
    'LIMITED'
) ips
JOIN sys.tables tbl
    ON ips.object_id = tbl.object_id
JOIN sys.schemas sch
    ON tbl.schema_id = sch.schema_id
JOIN sys.indexes idx
    ON ips.object_id = idx.object_id
    AND ips.index_id = idx.index_id
WHERE tbl.is_ms_shipped = 0
ORDER BY
    size_mb DESC;
