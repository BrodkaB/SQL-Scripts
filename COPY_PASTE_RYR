SELECT 
    s.name,
    t.target_name,
    CAST(t.target_data AS XML)
FROM sys.dm_xe_sessions s
JOIN sys.dm_xe_session_targets t 
    ON s.address = t.event_session_address
WHERE s.name = 'HANG_CAPTURE';

SELECT  
    DATEADD(hour, DATEDIFF(hour, GETUTCDATE(), SYSDATETIME()), 
        x.value('(event/@timestamp)[1]', 'datetime2')) AS local_time,
    x.value('(event/@name)[1]', 'varchar(100)') AS event_name,
    x.value('(event/data[@name="duration"]/value)[1]', 'bigint') AS duration,
    x.value('(event/action[@name="session_id"]/value)[1]', 'int') AS session_id,
    x.value('(event/action[@name="sql_text"]/value)[1]', 'nvarchar(max)') AS sql_text
FROM (
    SELECT CAST(event_data AS XML) AS x
    FROM sys.fn_xe_file_target_read_file(
        'D:\XE\hang_capture*.xel', NULL, NULL, NULL)
) t
ORDER BY local_time DESC;
