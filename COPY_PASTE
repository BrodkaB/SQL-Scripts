SELECT
    name,
    value AS configured_value,
    value_in_use
FROM sys.configurations
WHERE name IN
(
    'min server memory (MB)',
    'max server memory (MB)',
    'max degree of parallelism',
    'cost threshold for parallelism'
)
ORDER BY name;
GO

SELECT
    physical_memory_kb / 1024 AS physical_memory_mb,
    committed_kb / 1024 AS sql_committed_memory_mb,
    committed_target_kb / 1024 AS sql_target_memory_mb,
    visible_target_kb / 1024 AS visible_target_memory_mb
FROM sys.dm_os_sys_info;
GO

SELECT
    counter_name,
    cntr_value,
    CASE
        WHEN counter_name IN
        (
            'Total Server Memory (KB)',
            'Target Server Memory (KB)',
            'Database Cache Memory (KB)',
            'Free Memory (KB)',
            'Stolen Server Memory (KB)',
            'Granted Workspace Memory (KB)',
            'Memory Grants Pending'
        )
        THEN cntr_value / 1024.0
        ELSE NULL
    END AS value_mb_or_count
FROM sys.dm_os_performance_counters
WHERE object_name LIKE '%Memory Manager%'
  AND counter_name IN
  (
      'Total Server Memory (KB)',
      'Target Server Memory (KB)',
      'Database Cache Memory (KB)',
      'Free Memory (KB)',
      'Stolen Server Memory (KB)',
      'Granted Workspace Memory (KB)',
      'Memory Grants Pending'
  )
ORDER BY counter_name;
GO
