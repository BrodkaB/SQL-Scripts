PS C:\Windows\system32> $thumb = '17F821987A94DF450E7A10F7B9533F758A3BE3AF'
$cert = Get-ChildItem Cert:\LocalMachine\My |
    Where-Object Thumbprint -eq $thumb

$chain = New-Object System.Security.Cryptography.X509Certificates.X509Chain
$ok = $chain.Build($cert)

"Chain valid: $ok"
$chain.ChainStatus |
    Format-Table Status, StatusInformation -AutoSize

$chain.ChainElements |
    ForEach-Object {
        [PSCustomObject]@{
            Subject    = $_.Certificate.Subject
            Issuer     = $_.Certificate.Issuer
            Thumbprint = $_.Certificate.Thumbprint
        }
    } | Format-Table -AutoSize
