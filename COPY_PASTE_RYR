SELECT
    StartTime,
    DatabaseName,
    FileName,
    IntegerData * 8 / 1024 AS GrowthMB,
    ApplicationName,
    HostName,
    LoginName
FROM fn_trace_gettable(
(
    SELECT REVERSE(SUBSTRING(REVERSE(path),
                             CHARINDEX('\', REVERSE(path)), 260))
           + '\Log.trc'
    FROM sys.traces
    WHERE is_default = 1
), DEFAULT)
WHERE EventClass IN (92,93)
  AND DatabaseName = 'RYREFB'
ORDER BY StartTime DESC;


SELECT
    name,
    create_date,
    modify_date
FROM sys.databases
WHERE name = 'RYREFB';
