SELECT
    'Permissions' AS TempTable,
    c.column_id,
    c.name AS ColumnName
FROM tempdb.sys.columns c
WHERE c.object_id = OBJECT_ID('tempdb..#Permissions')

UNION ALL

SELECT
    'Comparison',
    c.column_id,
    c.name
FROM tempdb.sys.columns c
WHERE c.object_id = OBJECT_ID('tempdb..#Comparison')
ORDER BY TempTable, column_id;
