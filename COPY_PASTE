SET NOCOUNT ON;

SELECT
    'CREATE USER ' + QUOTENAME(u.name) +
    ' FOR LOGIN ' + QUOTENAME(sp.name) + ';' +
    CHAR(13) + CHAR(10) +
    STRING_AGG(
        'ALTER ROLE ' + QUOTENAME(r.name) +
        ' ADD MEMBER ' + QUOTENAME(u.name) + ';',
        CHAR(13) + CHAR(10)
    ) WITHIN GROUP (ORDER BY r.name) AS [RestoreScript]
FROM sys.database_principals u
JOIN sys.server_principals sp
    ON u.sid = sp.sid
LEFT JOIN sys.database_role_members drm
    ON u.principal_id = drm.member_principal_id
LEFT JOIN sys.database_principals r
    ON drm.role_principal_id = r.principal_id
WHERE u.type IN ('S', 'U', 'G')
  AND u.name NOT IN ('dbo', 'guest', 'INFORMATION_SCHEMA', 'sys')
GROUP BY
    u.name,
    sp.name
ORDER BY
    u.name;




