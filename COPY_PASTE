$cs = "Provider=MSOLEDBSQL19;Data Source=JLDB-DEV-03;Integrated Security=SSPI;Initial Catalog=BI-DEV;Encrypt=Mandatory;TrustServerCertificate=True"

$conn = New-Object System.Data.OleDb.OleDbConnection($cs)

try {
    $conn.Open()
    Write-Host "CONNECTED - OLE DB connection successful" -ForegroundColor Green

    $cmd = $conn.CreateCommand()
    $cmd.CommandText = "SELECT @@SERVERNAME AS ServerName, DB_NAME() AS DatabaseName"
    $reader = $cmd.ExecuteReader()

    while ($reader.Read()) {
        Write-Host "Server:   $($reader['ServerName'])"
        Write-Host "Database: $($reader['DatabaseName'])"
    }

    $reader.Close()
}
catch {
    Write-Host "CONNECTION FAILED" -ForegroundColor Red
    Write-Host $_.Exception.ToString()
}
finally {
    if ($conn.State -ne 'Closed') {
        $conn.Close()
    }
    $conn.Dispose()
}
