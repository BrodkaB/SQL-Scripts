-------------------------------------------------------------------------------
-- Result set 2: Comparison
-------------------------------------------------------------------------------

EXEC sys.sp_executesql N'
SELECT
    PermissionLevel,
    DatabaseName,
    Category,
    OldSecurable,
    NewSecurable,
    PermissionName,
    OldState,
    NewState,
    Result,
    OldDetails,
    NewDetails
FROM #Comparison
ORDER BY
    CASE Result
        WHEN ''MISSING_ON_NEW'' THEN 1
        WHEN ''DIFFERENT'' THEN 2
        WHEN ''EXTRA_ON_NEW'' THEN 3
        WHEN ''IDENTICAL'' THEN 4
        ELSE 5
    END,
    PermissionLevel,
    DatabaseName,
    Category,
    PermissionName;
';
