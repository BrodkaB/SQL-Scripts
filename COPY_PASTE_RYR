
/*
===============================================================================
 SQL SERVER LOGIN PERMISSIONS COMPARISON
 Compatible with SQL Server 2019

 Compares:
   1. Server-level login information
   2. Server role membership
   3. Server-level explicit permissions
   4. Database user mapping
   5. Database role membership
   6. Database-level explicit permissions

 Comparison results:
   IDENTICAL
   MISSING_ON_NEW
   EXTRA_ON_NEW
   DIFFERENT

 Scope:
   - SQL_LOGIN
   - WINDOWS_LOGIN
   - Direct permissions and role memberships
   - All online databases, including system databases

 Notes:
   - Does not expand permissions inherited through roles.
   - Does not resolve Windows AD group membership.
   - Does not compare effective permissions.
===============================================================================
*/

SET NOCOUNT ON;

-------------------------------------------------------------------------------
-- 1. CONFIGURATION
-------------------------------------------------------------------------------

DECLARE @OldLogin SYSNAME = N'DOMAIN\svc_app_old';
DECLARE @NewLogin SYSNAME = N'DOMAIN\svc_app_new';

DECLARE @OldSID VARBINARY(85);
DECLARE @NewSID VARBINARY(85);

-------------------------------------------------------------------------------
-- 2. VALIDATE LOGINS
-------------------------------------------------------------------------------

IF @OldLogin = @NewLogin
BEGIN
    THROW 50001, 'OldLogin and NewLogin cannot be the same.', 1;
END;

SELECT @OldSID = sid
FROM sys.server_principals
WHERE name = @OldLogin;

SELECT @NewSID = sid
FROM sys.server_principals
WHERE name = @NewLogin;

IF @OldSID IS NULL
BEGIN
    DECLARE @ErrorOld NVARCHAR(2048) =
        N'Login not found on this SQL Server: ' + @OldLogin;

    THROW 50002, @ErrorOld, 1;
END;

IF @NewSID IS NULL
BEGIN
    DECLARE @ErrorNew NVARCHAR(2048) =
        N'Login not found on this SQL Server: ' + @NewLogin;

    THROW 50003, @ErrorNew, 1;
END;

-------------------------------------------------------------------------------
-- 3. TEMPORARY TABLES
-------------------------------------------------------------------------------

IF OBJECT_ID('tempdb..#Permissions') IS NOT NULL
    DROP TABLE #Permissions;

IF OBJECT_ID('tempdb..#Comparison') IS NOT NULL
    DROP TABLE #Comparison;

IF OBJECT_ID('tempdb..#Errors') IS NOT NULL
    DROP TABLE #Errors;

CREATE TABLE #Permissions
(
    AccountSide       VARCHAR(3)       NOT NULL,
    PermissionLevel   VARCHAR(20)      NOT NULL,
    DatabaseName      SYSNAME          NULL,
    Category          VARCHAR(50)      NOT NULL,
    ItemKey           NVARCHAR(1000)   NOT NULL,
    Securable         NVARCHAR(1000)   NULL,
    PermissionName    NVARCHAR(256)    NULL,
    PermissionState   NVARCHAR(60)     NULL,
    Details           NVARCHAR(1000)   NULL
);

CREATE TABLE #Comparison
(
    PermissionLevel   VARCHAR(20),
    DatabaseName      SYSNAME,
    Category          VARCHAR(50),
    OldSecurable      NVARCHAR(1000),
    NewSecurable      NVARCHAR(1000),
    PermissionName    NVARCHAR(256),
    OldState          NVARCHAR(60),
    NewState          NVARCHAR(60),
    Result            VARCHAR(30),
    OldDetails        NVARCHAR(1000),
    NewDetails        NVARCHAR(1000)
);

CREATE TABLE #Errors
(
    DatabaseName SYSNAME,
    ErrorNumber  INT,
    ErrorMessage NVARCHAR(4000)
);

-------------------------------------------------------------------------------
-- 4. SERVER-LEVEL INFORMATION
-------------------------------------------------------------------------------

-- 4.1 Login information

INSERT INTO #Permissions
(
    AccountSide,
    PermissionLevel,
    DatabaseName,
    Category,
    ItemKey,
    Securable,
    PermissionName,
    PermissionState,
    Details
)
SELECT
    CASE WHEN sp.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    'SERVER',
    NULL,
    'SERVER_LOGIN',
    N'LOGIN',
    sp.name,
    N'LOGIN',
    CASE
        WHEN sp.is_disabled = 1 THEN N'DISABLED'
        ELSE N'ENABLED'
    END,
    CONCAT
    (
        N'Type: ', sp.type_desc,
        N'; Default database: ',
        COALESCE(sp.default_database_name, N'')
    )
FROM sys.server_principals sp
WHERE sp.sid IN (@OldSID, @NewSID);

-- 4.2 Server role membership

INSERT INTO #Permissions
(
    AccountSide,
    PermissionLevel,
    DatabaseName,
    Category,
    ItemKey,
    Securable,
    PermissionName,
    PermissionState,
    Details
)
SELECT
    CASE WHEN member.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    'SERVER',
    NULL,
    'SERVER_ROLE',
    role.name,
    role.name,
    N'ROLE MEMBERSHIP',
    NULL,
    N'Direct server role membership'
FROM sys.server_role_members srm
INNER JOIN sys.server_principals role
    ON role.principal_id = srm.role_principal_id
INNER JOIN sys.server_principals member
    ON member.principal_id = srm.member_principal_id
WHERE member.sid IN (@OldSID, @NewSID);

-- 4.3 Explicit server-level permissions

INSERT INTO #Permissions
(
    AccountSide,
    PermissionLevel,
    DatabaseName,
    Category,
    ItemKey,
    Securable,
    PermissionName,
    PermissionState,
    Details
)
SELECT
    CASE WHEN sp.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    'SERVER',
    NULL,
    'SERVER_PERMISSION',

    CONCAT
    (
        p.class_desc, N':',
        p.major_id, N':',
        p.minor_id, N':',
        p.permission_name
    ),

    CONCAT
    (
        p.class_desc, N':',
        p.major_id, N':',
        p.minor_id
    ),

    p.permission_name,
    p.state_desc,
    N'Direct server-level permission'
FROM sys.server_permissions p
INNER JOIN sys.server_principals sp
    ON sp.principal_id = p.grantee_principal_id
WHERE sp.sid IN (@OldSID, @NewSID);

-------------------------------------------------------------------------------
-- 5. DATABASE-LEVEL INFORMATION
-------------------------------------------------------------------------------

DECLARE @DatabaseName SYSNAME;
DECLARE @SQL NVARCHAR(MAX);

DECLARE DatabaseCursor CURSOR LOCAL FAST_FORWARD FOR
SELECT name
FROM sys.databases
WHERE state = 0
ORDER BY name;

OPEN DatabaseCursor;

FETCH NEXT FROM DatabaseCursor INTO @DatabaseName;

WHILE @@FETCH_STATUS = 0
BEGIN
    BEGIN TRY

        SET @SQL = N'
        USE ' + QUOTENAME(@DatabaseName) + N';

        -----------------------------------------------------------------------
        -- 5.1 Database user mapping
        -----------------------------------------------------------------------

        INSERT INTO #Permissions
        (
            AccountSide,
            PermissionLevel,
            DatabaseName,
            Category,
            ItemKey,
            Securable,
            PermissionName,
            PermissionState,
            Details
        )
        SELECT
            a.AccountSide,
            ''DATABASE'',
            DB_NAME(),
            ''DATABASE_USER'',
            N''DATABASE_USER'',
            dp.name,
            N''DATABASE USER'',
            NULL,
            CONCAT
            (
                N''Type: '', dp.type_desc,
                N''; Authentication: '',
                COALESCE(dp.authentication_type_desc, N''''),
                N''; Default schema: '',
                COALESCE(dp.default_schema_name, N'''')
            )
        FROM sys.database_principals dp
        CROSS APPLY
        (
            SELECT ''OLD'' AS AccountSide, @OldSID AS SID
            UNION ALL
            SELECT ''NEW'', @NewSID
        ) a
        WHERE dp.sid = a.SID;

        -----------------------------------------------------------------------
        -- 5.2 Database role membership
        -----------------------------------------------------------------------

        INSERT INTO #Permissions
        (
            AccountSide,
            PermissionLevel,
            DatabaseName,
            Category,
            ItemKey,
            Securable,
            PermissionName,
            PermissionState,
            Details
        )
        SELECT
            a.AccountSide,
            ''DATABASE'',
            DB_NAME(),
            ''DATABASE_ROLE'',
            CONCAT(N''ROLE:'', rolep.name),
            rolep.name,
            N''ROLE MEMBERSHIP'',
            NULL,
            N''Direct database role membership''
        FROM sys.database_role_members rm
        INNER JOIN sys.database_principals rolep
            ON rolep.principal_id = rm.role_principal_id
        INNER JOIN sys.database_principals memberp
            ON memberp.principal_id = rm.member_principal_id
        CROSS APPLY
        (
            SELECT ''OLD'' AS AccountSide, @OldSID AS SID
            UNION ALL
            SELECT ''NEW'', @NewSID
        ) a
        WHERE memberp.sid = a.SID;

        -----------------------------------------------------------------------
        -- 5.3 Explicit database-level permissions
        -----------------------------------------------------------------------

        INSERT INTO #Permissions
        (
            AccountSide,
            PermissionLevel,
            DatabaseName,
            Category,
            ItemKey,
            Securable,
            PermissionName,
            PermissionState,
            Details
        )
        SELECT
            a.AccountSide,
            ''DATABASE'',
            DB_NAME(),
            ''DATABASE_PERMISSION'',

            CONCAT
            (
                p.class_desc, N'':'',
                p.major_id, N'':'',
                p.minor_id, N'':'',
                p.permission_name
            ),

            CONCAT
            (
                p.class_desc, N'':'',
                p.major_id, N'':'',
                p.minor_id
            ),

            p.permission_name,
            p.state_desc,
            N''Direct database permission''
        FROM sys.database_permissions p
        INNER JOIN sys.database_principals dp
            ON dp.principal_id = p.grantee_principal_id
        CROSS APPLY
        (
            SELECT ''OLD'' AS AccountSide, @OldSID AS SID
            UNION ALL
            SELECT ''NEW'', @NewSID
        ) a
        WHERE dp.sid = a.SID;
        ';

        EXEC sys.sp_executesql
            @SQL,
            N'@OldSID VARBINARY(85), @NewSID VARBINARY(85)',
            @OldSID = @OldSID,
            @NewSID = @NewSID;

    END TRY
    BEGIN CATCH

        INSERT INTO #Errors
        (
            DatabaseName,
            ErrorNumber,
            ErrorMessage
        )
        VALUES
        (
            @DatabaseName,
            ERROR_NUMBER(),
            ERROR_MESSAGE()
        );

    END CATCH;

    FETCH NEXT FROM DatabaseCursor INTO @DatabaseName;
END;

CLOSE DatabaseCursor;
DEALLOCATE DatabaseCursor;

-------------------------------------------------------------------------------
-- 6. COMPARE OLD VS NEW
-------------------------------------------------------------------------------

;WITH OldData AS
(
    SELECT *
    FROM #Permissions
    WHERE AccountSide = 'OLD'
),
NewData AS
(
    SELECT *
    FROM #Permissions
    WHERE AccountSide = 'NEW'
)
INSERT INTO #Comparison
(
    PermissionLevel,
    DatabaseName,
    Category,
    OldSecurable,
    NewSecurable,
    PermissionName,
    OldState,
    NewState,
    Result,
    OldDetails,
    NewDetails
)
SELECT
    COALESCE(o.PermissionLevel, n.PermissionLevel),
    COALESCE(o.DatabaseName, n.DatabaseName),
    COALESCE(o.Category, n.Category),
    o.Securable,
    n.Securable,
    COALESCE(o.PermissionName, n.PermissionName),
    o.PermissionState,
    n.PermissionState,

    CASE
        WHEN o.ItemKey IS NULL
            THEN 'EXTRA_ON_NEW'

        WHEN n.ItemKey IS NULL
            THEN 'MISSING_ON_NEW'

        WHEN ISNULL(o.PermissionState, N'')
             <> ISNULL(n.PermissionState, N'')

          OR ISNULL(o.Details, N'')
             <> ISNULL(n.Details, N'')

            THEN 'DIFFERENT'

        ELSE 'IDENTICAL'
    END,

    o.Details,
    n.Details

FROM OldData o
FULL OUTER JOIN NewData n
    ON  o.PermissionLevel = n.PermissionLevel
    AND ISNULL(o.DatabaseName, N'') = ISNULL(n.DatabaseName, N'')
    AND o.Category = n.Category
    AND o.ItemKey = n.ItemKey;

-------------------------------------------------------------------------------
-- 7. RESULTS
-------------------------------------------------------------------------------

-- Result set 1: Complete permission inventory

SELECT
    AccountSide,
    CASE
        WHEN AccountSide = 'OLD' THEN @OldLogin
        ELSE @NewLogin
    END AS LoginName,
    PermissionLevel,
    DatabaseName,
    Category,
    Securable,
    PermissionName,
    PermissionState,
    Details
FROM #Permissions
ORDER BY
    PermissionLevel,
    DatabaseName,
    AccountSide,
    Category,
    Securable;

-------------------------------------------------------------------------------
-- Result set 2: Comparison

SELECT
    PermissionLevel,
    DatabaseName,
    Category,
    OldSecurable,
    NewSecurable,
    PermissionName,
    OldState,
    NewState,
    Result,
    OldDetails,
    NewDetails
FROM #Comparison
ORDER BY
    CASE Result
        WHEN 'MISSING_ON_NEW' THEN 1
        WHEN 'DIFFERENT' THEN 2
        WHEN 'EXTRA_ON_NEW' THEN 3
        WHEN 'IDENTICAL' THEN 4
        ELSE 5
    END,
    PermissionLevel,
    DatabaseName,
    Category,
    PermissionName;

-------------------------------------------------------------------------------
-- Result set 3: Comparison summary

SELECT
    Result,
    COUNT(*) AS NumberOfEntries
FROM #Comparison
GROUP BY Result
ORDER BY Result;

-------------------------------------------------------------------------------
-- Result set 4: Database collection errors

SELECT
    DatabaseName,
    ErrorNumber,
    ErrorMessage
FROM #Errors
ORDER BY DatabaseName;

-------------------------------------------------------------------------------
-- END
-------------------------------------------------------------------------------
