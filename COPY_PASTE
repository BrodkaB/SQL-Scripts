t.TAXABLE,  
tm.BILLABLE_FLAG,  
t.BILL_TRAN_UNO,  
tm.CURRENCY_CODE,  
tm.OFFC,  
tm.DEPT,  
tm.PROF,  
tm.DRUNO,  
NULL as BILL_DRUNO,  
t.PHTASK_UNO,  
tm.[PERIOD],  
tm.PROJ,  
t.RETAINED_BILLED_AMT,  
t.RETAINED_BILLED_HRS,  
t.GROSS_AMT,  
t.ADV_PREMDISC_AMT,  
t.CTS_PREMDISC_AMT,  
0 AS BILLED_TOBILL_HRS,  
0 AS BILLED_BASE_AMT,  
0 AS BILLED_TOBILL_AMT,  
CONVERT(INT,LEFT(CONVERT(VARCHAR(10), tm.TRAN_DATE,112),6)) AS TRAN_MONTH,  
0 AS BASE_HRS_TT,  
0 AS TOBILL_HRS_TT,  
0 AS BILLED_HRS_TT,  
0 AS BASE_AMT_TT,  
0 AS TOBILL_AMT_TT,  
0 AS BILLED_AMT_TT,  
0 AS BILLED_AMT_BILLING_TT,  
0 AS STD_AMT_TT'  
--CustomFields  
TRUNCATE TABLE #CustomFields  
