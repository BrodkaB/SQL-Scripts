
USE master;
GO

SET NOCOUNT ON;

------------------------------------------------------------
-- CONFIGURATION
------------------------------------------------------------

DECLARE @OldLogin SYSNAME = N'DOMAIN\svc_app_old';
DECLARE @NewLogin SYSNAME = N'DOMAIN\svc_app_new';

------------------------------------------------------------
-- VALIDATION
------------------------------------------------------------

DECLARE @OldSID VARBINARY(85);
DECLARE @NewSID VARBINARY(85);

SELECT @OldSID = sid
FROM sys.server_principals
WHERE name = @OldLogin;

SELECT @NewSID = sid
FROM sys.server_principals
WHERE name = @NewLogin;

IF @OldSID IS NULL OR @NewSID IS NULL
BEGIN
    RAISERROR('One or both SQL Server logins do not exist.',16,1);
    RETURN;
END;

IF @OldSID = @NewSID
BEGIN
    RAISERROR('Both logins have the same SID.',16,1);
    RETURN;
END;

IF IS_SRVROLEMEMBER('sysadmin') <> 1
BEGIN
    RAISERROR('Run as sysadmin for complete visibility.',16,1);
    RETURN;
END;

------------------------------------------------------------
-- TEMP TABLE
------------------------------------------------------------

DROP TABLE IF EXISTS #Permissions;

CREATE TABLE #Permissions
(
    AccountSide VARCHAR(3),
    PermissionLevel VARCHAR(20),
    DatabaseName SYSNAME NULL,
    Category VARCHAR(50),
    ItemKey NVARCHAR(1000),
    Securable NVARCHAR(1000),
    PermissionName NVARCHAR(256),
    PermissionState NVARCHAR(60),
    Details NVARCHAR(1000)
);

------------------------------------------------------------
-- 1. SERVER ROLE MEMBERSHIP
------------------------------------------------------------

INSERT INTO #Permissions
SELECT
    CASE WHEN member.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    'SERVER',
    NULL,
    'SERVER_ROLE',
    role.name,
    role.name,
    'ROLE MEMBERSHIP',
    'MEMBER',
    'Server role membership'
FROM sys.server_role_members rm
JOIN sys.server_principals member
    ON rm.member_principal_id = member.principal_id
JOIN sys.server_principals role
    ON rm.role_principal_id = role.principal_id
WHERE member.sid IN (@OldSID,@NewSID);

------------------------------------------------------------
-- 2. SERVER PERMISSIONS
------------------------------------------------------------

INSERT INTO #Permissions
SELECT
    CASE WHEN sp.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    'SERVER',
    NULL,
    'SERVER_PERMISSION',

    CONCAT(
        p.class_desc, ':',
        p.major_id, ':',
        p.minor_id, ':',
        p.permission_name
    ),

    CASE
        WHEN p.class_desc = 'SERVER'
            THEN 'SERVER'

        WHEN p.class_desc = 'ENDPOINT'
            THEN ep.name

        WHEN p.class_desc = 'SERVER_PRINCIPAL'
            THEN target_principal.name

        ELSE CONCAT(p.class_desc, ':',p.major_id)
    END,

    p.permission_name,
    p.state_desc,
    p.class_desc

FROM sys.server_permissions p
JOIN sys.server_principals sp
    ON p.grantee_principal_id = sp.principal_id
LEFT JOIN sys.endpoints ep
    ON p.class_desc = 'ENDPOINT'
    AND ep.endpoint_id = p.major_id
LEFT JOIN sys.server_principals target_principal
    ON p.class_desc = 'SERVER_PRINCIPAL'
    AND target_principal.principal_id = p.major_id
WHERE sp.sid IN (@OldSID,@NewSID);

------------------------------------------------------------
-- 3. DATABASE COLLECTION
------------------------------------------------------------

DECLARE @DB SYSNAME;
DECLARE @SQL NVARCHAR(MAX);

DECLARE db_cursor CURSOR LOCAL FAST_FORWARD FOR
SELECT name
FROM sys.databases
WHERE state_desc = 'ONLINE'
  AND HAS_DBACCESS(name) = 1;

OPEN db_cursor;

FETCH NEXT FROM db_cursor INTO @DB;

WHILE @@FETCH_STATUS = 0
BEGIN

    SET @SQL = N'
    USE ' + QUOTENAME(@DB) + N';

    --------------------------------------------------------
    -- DATABASE ACCESS / USER MAPPING
    --------------------------------------------------------

    INSERT INTO #Permissions
    SELECT
        CASE WHEN dp.sid = @OldSID THEN ''OLD'' ELSE ''NEW'' END,
        ''DATABASE'',
        DB_NAME(),
        ''DATABASE_USER'',
        ''DATABASE_ACCESS'',
        dp.name,
        ''DATABASE ACCESS'',
        ''MAPPED'',
        CONCAT(
            dp.type_desc,
            '' | Authentication: '',
            dp.authentication_type_desc,
            '' | Default schema: '',
            ISNULL(dp.default_schema_name,'''')
        )
    FROM sys.database_principals dp
    WHERE dp.sid IN (@OldSID,@NewSID)
      AND dp.type IN (''S'',''U'',''G'');

    --------------------------------------------------------
    -- DATABASE ROLE MEMBERSHIP
    --------------------------------------------------------

    INSERT INTO #Permissions
    SELECT
        CASE WHEN dp.sid = @OldSID THEN ''OLD'' ELSE ''NEW'' END,
        ''DATABASE'',
        DB_NAME(),
        ''DATABASE_ROLE'',
        role.name,
        role.name,
        ''ROLE MEMBERSHIP'',
        ''MEMBER'',
        CONCAT(''Database user: '',dp.name)
    FROM sys.database_role_members drm
    JOIN sys.database_principals role
        ON drm.role_principal_id = role.principal_id
    JOIN sys.database_principals dp
        ON drm.member_principal_id = dp.principal_id
    WHERE dp.sid IN (@OldSID,@NewSID);

    --------------------------------------------------------
    -- DIRECT DATABASE PERMISSIONS
    --------------------------------------------------------

    INSERT INTO #Permissions
    SELECT
        CASE WHEN dp.sid = @OldSID THEN ''OLD'' ELSE ''NEW'' END,
        ''DATABASE'',
        DB_NAME(),
        ''DATABASE_PERMISSION'',

        CONCAT(
            p.class_desc, '':'',
            p.major_id, '':'',
            p.minor_id, '':'',
            p.permission_name
        ),

        CASE
            WHEN p.class_desc = ''DATABASE''
                THEN DB_NAME()

            WHEN p.class_desc = ''SCHEMA''
                THEN SCHEMA_NAME(p.major_id)

            WHEN p.class_desc = ''OBJECT_OR_COLUMN''
                THEN
                    QUOTENAME(OBJECT_SCHEMA_NAME(p.major_id))
                    + ''.'' +
                    QUOTENAME(OBJECT_NAME(p.major_id))
                    + CASE
                        WHEN p.minor_id > 0
                        THEN ''.'' + QUOTENAME(
                            COL_NAME(p.major_id,p.minor_id)
                        )
                        ELSE ''''
                      END

            WHEN p.class_desc = ''DATABASE_PRINCIPAL''
                THEN USER_NAME(p.major_id)

            ELSE CONCAT(p.class_desc,'':'',p.major_id)
        END,

        p.permission_name,
        p.state_desc,
        CONCAT(
            ''Class: '',p.class_desc,
            '' | Grantee: '',dp.name
        )

    FROM sys.database_permissions p
    JOIN sys.database_principals dp
        ON p.grantee_principal_id = dp.principal_id
    WHERE dp.sid IN (@OldSID,@NewSID);

    ';

    EXEC sys.sp_executesql
        @SQL,
        N'@OldSID VARBINARY(85), @NewSID VARBINARY(85)',
        @OldSID = @OldSID,
        @NewSID = @NewSID;

    FETCH NEXT FROM db_cursor INTO @DB;
END;

CLOSE db_cursor;
DEALLOCATE db_cursor;

------------------------------------------------------------
-- 4. COMPARISON
------------------------------------------------------------

DROP TABLE IF EXISTS #Comparison;

CREATE TABLE #Comparison
(
    PermissionLevel VARCHAR(20),
    DatabaseName SYSNAME NULL,
    Category VARCHAR(50),
    Securable NVARCHAR(1000),
    PermissionName NVARCHAR(256),
    OldState NVARCHAR(60),
    NewState NVARCHAR(60),
    Result VARCHAR(30),
    OldDetails NVARCHAR(1000),
    NewDetails NVARCHAR(1000)
);

;WITH OldData AS
(
    SELECT *
    FROM #Permissions
    WHERE AccountSide = 'OLD'
),
NewData AS
(
    SELECT *
    FROM #Permissions
    WHERE AccountSide = 'NEW'
)
INSERT INTO #Comparison
SELECT
    COALESCE(o.PermissionLevel,n.PermissionLevel),
    COALESCE(o.DatabaseName,n.DatabaseName),
    COALESCE(o.Category,n.Category),
    COALESCE(o.Securable,n.Securable),
    COALESCE(o.PermissionName,n.PermissionName),
    o.PermissionState,
    n.PermissionState,

    CASE
        WHEN o.Category IS NULL
            THEN 'EXTRA_ON_NEW'

        WHEN n.Category IS NULL
            THEN 'MISSING_ON_NEW'

        WHEN ISNULL(o.PermissionState,'') <>
             ISNULL(n.PermissionState,'')
          OR ISNULL(o.Details,'') <>
             ISNULL(n.Details,'')
            THEN 'DIFFERENT'

        ELSE 'IDENTICAL'
    END,

    o.Details,
    n.Details

FROM OldData o
FULL OUTER JOIN NewData n
    ON o.PermissionLevel = n.PermissionLevel
    AND ISNULL(o.DatabaseName,'') = ISNULL(n.DatabaseName,'')
    AND o.Category = n.Category
    AND o.ItemKey = n.ItemKey;

------------------------------------------------------------
-- 5. RESULTS
------------------------------------------------------------

PRINT '==========================================';
PRINT '1. OLD LOGIN INVENTORY';
PRINT '==========================================';

SELECT *
FROM #Permissions
WHERE AccountSide = 'OLD'
ORDER BY PermissionLevel,DatabaseName,Category,Securable;

PRINT '==========================================';
PRINT '2. NEW LOGIN INVENTORY';
PRINT '==========================================';

SELECT *
FROM #Permissions
WHERE AccountSide = 'NEW'
ORDER BY PermissionLevel,DatabaseName,Category,Securable;

PRINT '==========================================';
PRINT '3. COMPARISON SUMMARY';
PRINT '==========================================';

SELECT
    Result,
    COUNT(*) AS Total
FROM #Comparison
GROUP BY Result
ORDER BY Result;

PRINT '==========================================';
PRINT '4. DIFFERENCES';
PRINT '==========================================';

SELECT *
FROM #Comparison
WHERE Result <> 'IDENTICAL'
ORDER BY
    PermissionLevel,
    DatabaseName,
    Category,
    Securable;

PRINT '==========================================';
PRINT '5. DATABASE ACCESS SUMMARY';
PRINT '==========================================';

SELECT
    DatabaseName,
    MAX(CASE WHEN AccountSide = 'OLD'
        THEN 1 ELSE 0 END) AS OldLoginHasAccess,
    MAX(CASE WHEN AccountSide = 'NEW'
        THEN 1 ELSE 0 END) AS NewLoginHasAccess
FROM
(
    SELECT AccountSide,DatabaseName
    FROM #Permissions
    WHERE Category = 'DATABASE_USER'
) d
GROUP BY DatabaseName
ORDER BY DatabaseName;

PRINT '==========================================';
PRINT 'COMPARISON FINISHED';
PRINT '==========================================';
