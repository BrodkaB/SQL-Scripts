---1. Login verification
USE master;
GO

DECLARE @LoginName sysname =
    N'JACKSONLEWIS\svc_AzCatalyst';

SELECT
    sp.name AS LoginName,
    sp.type_desc,
    sp.is_disabled,
    sp.sid,
    perm.permission_name,
    perm.state_desc
FROM sys.server_principals sp
LEFT JOIN sys.server_permissions perm
    ON sp.principal_id = perm.grantee_principal_id
WHERE sp.name = @LoginName;

---2. Database users verification
DECLARE @LoginName sysname =
    N'JACKSONLEWIS\svc_AzCatalyst';

CREATE TABLE #UserCheck
(
    DatabaseName sysname,
    UserName sysname NULL,
    UserSID varbinary(85) NULL,
    LoginSID varbinary(85) NULL,
    SID_Match bit NULL,
    Status varchar(30)
);

DECLARE @DB sysname;
DECLARE @SQL nvarchar(max);

DECLARE db_cursor CURSOR LOCAL FAST_FORWARD FOR
SELECT name
FROM sys.databases
WHERE database_id > 0
  AND name NOT IN ('tempdb', 'model')
  AND state_desc = 'ONLINE'
  AND source_database_id IS NULL;

OPEN db_cursor;

FETCH NEXT FROM db_cursor INTO @DB;

WHILE @@FETCH_STATUS = 0
BEGIN

    SET @SQL = N'
    USE ' + QUOTENAME(@DB) + N';

    INSERT INTO #UserCheck
    SELECT
        DB_NAME(),
        dp.name,
        dp.sid,
        SUSER_SID(@LoginName),
        CASE
            WHEN dp.sid = SUSER_SID(@LoginName) THEN 1
            ELSE 0
        END,
        CASE
            WHEN dp.principal_id IS NULL THEN ''MISSING''
            WHEN dp.sid = SUSER_SID(@LoginName) THEN ''OK''
            ELSE ''SID MISMATCH''
        END
    FROM (SELECT 1 AS Dummy) x
    LEFT JOIN sys.database_principals dp
        ON dp.name = @LoginName;
    ';

    EXEC sys.sp_executesql
        @SQL,
        N'@LoginName sysname',
        @LoginName = @LoginName;

    FETCH NEXT FROM db_cursor INTO @DB;

END;

CLOSE db_cursor;
DEALLOCATE db_cursor;

SELECT *
FROM #UserCheck
ORDER BY DatabaseName;

DROP TABLE #UserCheck;


---3. Database permissions verification 
DECLARE @LoginName sysname =
    N'JACKSONLEWIS\svc_AzCatalyst';

CREATE TABLE #PermissionCheck
(
    DatabaseName sysname,
    PermissionName sysname,
    StateDesc nvarchar(60),
    Status varchar(20)
);

DECLARE @DB sysname;
DECLARE @SQL nvarchar(max);

DECLARE db_cursor CURSOR LOCAL FAST_FORWARD FOR
SELECT name
FROM sys.databases
WHERE database_id > 0
  AND name NOT IN ('tempdb', 'model')
  AND state_desc = 'ONLINE'
  AND source_database_id IS NULL;

OPEN db_cursor;

FETCH NEXT FROM db_cursor INTO @DB;

WHILE @@FETCH_STATUS = 0
BEGIN

    SET @SQL = N'
    USE ' + QUOTENAME(@DB) + N';

    INSERT INTO #PermissionCheck
    SELECT
        DB_NAME(),
        p.permission_name,
        p.state_desc,
        CASE
            WHEN p.state_desc = ''GRANT'' THEN ''OK''
            ELSE ''CHECK''
        END
    FROM sys.database_permissions p
    INNER JOIN sys.database_principals dp
        ON p.grantee_principal_id = dp.principal_id
    WHERE dp.name = @LoginName
      AND p.permission_name IN
          (''VIEW DATABASE STATE'', ''SELECT'');
    ';

    EXEC sys.sp_executesql
        @SQL,
        N'@LoginName sysname',
        @LoginName = @LoginName;

    FETCH NEXT FROM db_cursor INTO @DB;

END;

CLOSE db_cursor;
DEALLOCATE db_cursor;

SELECT *
FROM #PermissionCheck
ORDER BY DatabaseName, PermissionName;

DROP TABLE #PermissionCheck;


---4. msdb verification
USE msdb;
GO

SELECT
    dp.name AS UserName,
    o.name AS ObjectName,
    p.permission_name,
    p.state_desc
FROM sys.database_permissions p
JOIN sys.database_principals dp
    ON p.grantee_principal_id = dp.principal_id
JOIN sys.objects o
    ON p.major_id = o.object_id
WHERE dp.name = N'JACKSONLEWIS\svc_AzCatalyst'
ORDER BY o.name, p.permission_name;
