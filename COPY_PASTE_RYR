    0
FROM #DBUsers;

INSERT INTO #Inventory
SELECT
    AccountType,
    'DATABASE_ROLE',
    DatabaseName,
    RoleName,
    'MEMBERSHIP',
    'MEMBER',
    UserName,
    RepairDDL,
    0
FROM #DBRoles;

INSERT INTO #Inventory
SELECT
    AccountType,
    'DATABASE_PERMISSION',
    DatabaseName,
    Securable,
    PermissionName,
    StateDesc,
    ClassDesc,
    RepairDDL,
    ReviewRequired
FROM #DBPermissions;

INSERT INTO #Inventory
SELECT
    AccountType,
    'OWNERSHIP',
    DatabaseName,
    ObjectName,
    OwnershipType,
    'OWNER',
    ObjectName,
    NULL,
    1
FROM #DBOwnership;

------------------------------------------------------------
-- 6. DIFFERENCE REPORT
------------------------------------------------------------

CREATE TABLE #Comparison
(
    Category VARCHAR(50),
    ScopeName SYSNAME,
    Securable NVARCHAR(1000),
    PermissionName NVARCHAR(256),
    OldState NVARCHAR(60),
    OldDetails NVARCHAR(1000),
    NewState NVARCHAR(60),
    NewDetails NVARCHAR(1000),
    Result VARCHAR(30),
    RepairDDL NVARCHAR(MAX),
    ReviewRequired BIT
);

;WITH OldData AS
(
    SELECT *
    FROM #Inventory
    WHERE AccountType = 'OLD'
),
NewData AS
(
    SELECT *
    FROM #Inventory
    WHERE AccountType = 'NEW'
)
INSERT INTO #Comparison
SELECT
    COALESCE(o.Category,n.Category),
    COALESCE(o.ScopeName,n.ScopeName),
    COALESCE(o.Securable,n.Securable),
    COALESCE(o.PermissionName,n.PermissionName),

    o.PermissionState,
    o.Details,

    n.PermissionState,
    n.Details,

    CASE
        WHEN o.Category IS NULL THEN 'EXTRA_ON_NEW'
        WHEN n.Category IS NULL THEN 'MISSING_ON_NEW'
        WHEN ISNULL(o.PermissionState,'') <>
             ISNULL(n.PermissionState,'')
          OR ISNULL(o.Details,'') <>
             ISNULL(n.Details,'')
            THEN 'DIFFERENT'
        ELSE 'IDENTICAL'
    END,

    CASE
        WHEN n.Category IS NULL THEN o.RepairDDL
        ELSE NULL
    END,

    CASE
        WHEN ISNULL(o.ReviewRequired,0) = 1
          OR ISNULL(n.ReviewRequired,0) = 1
            THEN 1
        ELSE 0
    END

FROM OldData o
FULL OUTER JOIN NewData n
    ON o.Category = n.Category
    AND o.ScopeName = n.ScopeName
    AND o.Securable = n.Securable
    AND o.PermissionName = n.PermissionName;

