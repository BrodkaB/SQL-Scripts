$log = Get-ChildItem `
'C:\Program Files\Microsoft SQL Server\160\Setup Bootstrap\Log\20260812_113555' `
-Recurse -File |
Where-Object {
    $_.Name -match 'SQLServer_ERRORLOG|sql_engine|engine'
} |
Sort-Object Length -Descending |
Select-Object -First 1

$log.FullName

Select-String `
-Path $log.FullName `
-Pattern 'error|failed|cannot|unable|could not|exception|0x|FCB|master|permission|access|startup' `
-CaseSensitive:$false `
-Context 2,3

Get-CimClass -Namespace 'root\Microsoft\SqlServer\ComputerManagement16' |
Where-Object {
    $_.CimClassName -match 'SqlService|ServerSettings|Sql'
} |
Select-Object CimClassName