SELECT
    'DROP USER ' + QUOTENAME(dp.name) + ';' AS [DropStatement]
FROM sys.database_principals dp
WHERE dp.type IN ('S', 'U', 'G')
  AND dp.name NOT IN
      ('dbo', 'guest', 'INFORMATION_SCHEMA', 'sys')
  AND dp.name NOT LIKE '##%'
ORDER BY dp.name;
