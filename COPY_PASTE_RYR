SELECT
    SUM(total_pages) * 8.0 / 1024 AS TotalMB,
    SUM(used_pages) * 8.0 / 1024 AS UsedMB,
    SUM(data_pages) * 8.0 / 1024 AS DataMB,
    (SUM(total_pages) - SUM(used_pages)) * 8.0 / 1024 AS UnusedMB
FROM sys.allocation_units
WHERE container_id IN
(
    SELECT hobt_id
    FROM sys.partitions
    WHERE object_id = OBJECT_ID('dbo.D996M')
      AND index_id = 0
);
