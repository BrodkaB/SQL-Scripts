Get-ChildItem Cert:\LocalMachine\Root |
    Where-Object { $_.Subject -like '*jacksonlewis-JL-ICA-E01-CA*' } |
    Select-Object Subject, Issuer, Thumbprint


Get-ChildItem Cert:\LocalMachine\CA |
    Where-Object { $_.Subject -like '*jacksonlewis-JL-ICA-E01-CA*' } |
    Select-Object Subject, Issuer, Thumbprint
