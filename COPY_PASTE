CREATE PROCEDURE DBO.SP_CMS_MATTER_LOG(@MATTER_UNO INT) AS  set nocount on  declare @input_uno char(32)  select @input_uno = convert(char(32),@MATTER_UNO)  declare @message char(255)  select @message = 'called sp_cms_matter_log ' + @input_uno  print @message  declare @MATTER_LOG_IN_USE char(1)  select  @MATTER_LOG_IN_USE = FLAG_VALUE  from CMS_OPTION  where OPTION_CODE = 'MAT_STATLOG'  if  isnull(@MATTER_LOG_IN_USE, 'N') != 'Y'  begin  return  end  declare @today char(12)  select  @today = CONVERT(varchar(12), getdate())  declare @manually_edited char(1)  declare @rowcount int  declare @modd_row_uno int  declare @todo char(1)  declare @change_empl_uno int  declare @mylogin varchar(80)  execute sp_cms_login_name @login_name = @mylogin output  select @change_empl_uno = 0  if len(@mylogin) > 0  begin  select @change_empl_uno = EMPL_UNO from HBM_PERSNL  where LOGIN = @mylogin  end  if exists(select * from HBA_MATTER_MODD  where MATTER_UNO = @MATTER_UNO and FROM_DATE >= @today )  begin  select @manually_edited = 'E'  select @manually_edited = MANUALLY_EDITED, @modd_row_uno = ROW_UNO from HBA_MATTER_MODD  where MATTER_UNO = @MATTER_UNO and FROM_DATE = @today  select @rowcount = @@ROWCOUNT  if @rowcount = 1  begin  if @manually_edited = 'Y'  begin  select @manually_edited = 'E'  select @todo = 'I'  end  else  begin  select @todo = 'U'  if @manually_edited <> 'N'  begin  select @manually_edited = 'E'  end  end  end  else  begin  if @rowcount = 0  begin  select @todo = 'I'  end  else  begin  select @manually_edited = 'E'  declare @modd_row_uno_tmp int  select @modd_row_uno_tmp = 0  select @modd_row_uno_tmp = ROW_UNO from HBA_MATTER_MODD  where MATTER_UNO = @MATTER_UNO and FROM_DATE = @today and MANUALLY_EDITED = 'E'  if @modd_row_uno_tmp <> 0  begin  select @todo = 'U'  select @modd_row_uno = @modd_row_uno_tmp  end  else  begin  select @todo = 'I'  end  end  end  end  else  begin  select @manually_edited = 'N'  select @todo = 'I'  end  if @todo = 'I'  begin  declare @ROW_UNO int  execute sp_cmsnextkey_output 'HBA_MATTER_MODD',1, @ROW_UNO output  insert  into HBA_MATTER_MODD (LAST_MODIFIED, ROW_UNO, MANUALLY_EDITED, MATTER_UNO, FROM_DATE, TO_DATE,  OFFC, DEPT, PROF, STATUS_CODE, MATT_TYPE_CODE, MATT_CLASS_CODE, MATT_CAT_CODE,  CHANGE_EMPL_UNO, RESP_EMPL_UNO, BILL_EMPL_UNO, ASSIGN_EMPL_UNO,  RATE_LEVEL, ALLOW_TIME, TIME_CLASS, TIME_TYPE_CODE, TM_RATE_SET_UNO, ALLOW_DISB,  DISB_CLASS, DI_RATE_SET_UNO, ALLOW_BILL)  select getdate(), @ROW_UNO, @manually_edited, @MATTER_UNO, @today, 'DEC 31 2099',  H.OFFC, H.DEPT, H.PROF, H.STATUS_CODE, H.MATT_TYPE_CODE, H.MATT_CLASS_CODE, H.MATT_CAT_CODE,  @change_empl_uno, H.RESP_EMPL_UNO, H.BILL_EMPL_UNO, H.ASSIGN_EMPL_UNO,  T.RATE_LEVEL, T.ALLOW_TIME, T.TIME_CLASS, T.TIME_TYPE_CODE, T.TM_RATE_SET_UNO, T.ALLOW_DISB,  T.DISB_CLASS, T.DI_RATE_SET_UNO, T.ALLOW_BILL  from HBM_MATTER H, TBM_MATTER T  where H.MATTER_UNO = T.MATTER_UNO and H.MATTER_UNO = @MATTER_UNO  declare @yesterday datetime  select @yesterday = DATEADD(day, -1, getdate())  if (@manually_edited in ('Y', 'N'))  begin  update hba_matter_modd set to_date=CONVERT(varchar(12), @yesterday)  where matter_uno=@matter_uno and  from_date=(select max(from_date) from hba_matter_modd where from_date<@today and matter_uno=@matter_uno)  end  end  else  begin  if @todo = 'U' and @modd_row_uno <> 0  begin  update HBA_MATTER_MODD set LAST_MODIFIED = getdate(),MANUALLY_EDITED = @manually_edited,  OFFC = H.OFFC, DEPT = H.DEPT, PROF = H.PROF, STATUS_CODE = H.STATUS_CODE,  MATT_TYPE_CODE = H.MATT_TYPE_CODE, MATT_CLASS_CODE = H.MATT_CLASS_CODE,  MATT_CAT_CODE = H.MATT_CAT_CODE, CHANGE_EMPL_UNO = @change_empl_uno,  RESP_EMPL_UNO = H.RESP_EMPL_UNO, BILL_EMPL_UNO = H.BILL_EMPL_UNO,  ASSIGN_EMPL_UNO = H.ASSIGN_EMPL_UNO, RATE_LEVEL = T.RATE_LEVEL,  ALLOW_TIME = T.ALLOW_TIME, TIME_CLASS = T.TIME_CLASS,  TIME_TYPE_CODE = T.TIME_TYPE_CODE, TM_RATE_SET_UNO = T.TM_RATE_SET_UNO,  ALLOW_DISB = T.ALLOW_DISB, DISB_CLASS = T.DISB_CLASS,  DI_RATE_SET_UNO = T.DI_RATE_SET_UNO, ALLOW_BILL = T.ALLOW_BILL  from HBM_MATTER H, TBM_MATTER T  where ROW_UNO = @modd_row_uno and H.MATTER_UNO = T.MATTER_UNO and H.MATTER_UNO = @MATTER_UNO  end  else  begin  return 1  end  end  
