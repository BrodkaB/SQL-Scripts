SELECT 
    t.name AS TableName,
    SUM(a.total_pages) * 8.0 / 1024 AS TotalSizeMB,
    SUM(a.used_pages) * 8.0 / 1024 AS UsedSizeMB,
    
    SUM(
        CASE 
            WHEN i.index_id IN (0,1) THEN a.data_pages 
            ELSE 0 
        END
    ) * 8.0 / 1024 AS DataSizeMB,

    SUM(
        CASE 
            WHEN i.index_id > 1 THEN a.used_pages 
            ELSE 0 
        END
    ) * 8.0 / 1024 AS IndexSizeMB

FROM sys.tables t
JOIN sys.indexes i 
    ON t.object_id = i.object_id
JOIN sys.partitions p 
    ON i.object_id = p.object_id 
    AND i.index_id = p.index_id
JOIN sys.allocation_units a 
    ON p.partition_id = a.container_id

WHERE t.name IN
(
    'AncillaryRevenueLegSummaryHistory',
    'AncillaryRevenueODSummaryHistory',
    'AncillaryRevenueLegDetailHistory',
    'AncillaryRevenueODDetailHistory'
)

GROUP BY t.name
ORDER BY TotalSizeMB DESC;
