Create PROCEDURE [dbo].[SUP_SYNC_DETAIL_TABLES]  
@SkipJobCheck bit = 0  
AS  
SET NOCOUNT ON  
SET QUOTED_IDENTIFIER ON  
SET ANSI_NULLS ON  
SET ANSI_PADDING ON;  
SET ANSI_WARNINGS ON;  
SET ARITHABORT ON;  
SET CONCAT_NULL_YIELDS_NULL ON;  
SET NUMERIC_ROUNDABORT OFF;  
DECLARE @ErrorMessage NVARCHAR(4000)  
DECLARE @ErrorSeverity INT  
DECLARE @ErrorState INT  
DECLARE @MaxRV RowVersion  
DECLARE @SqlQuery NVARCHAR(max)  
DECLARE @CustomFields NVARCHAR(max) = ''  
DECLARE @result smallint = 1  
Declare @tot_rows bigint  
SET @tot_rows = 0  
DECLARE @error varchar(200)  
DECLARE @LOCKSTATUS TABLE (RETURN_CODE varchar(30))  
INSERT INTO @LOCKSTATUS  
Exec [dbo].[SUP_FULLREBUILD_JOB_LOCK] 'CHECK'  
--Check if the summary table full rebuild job is still running or fail  
IF NOT EXISTS (SELECT * FROM @LOCKSTATUS WHERE RETURN_CODE = 'NO LOCK') AND @SkipJobCheck = 0  
BEGIN  
SET @error='The summary table full rebuild job is still running or fail. The Summary Table Incremental Sync job can be running until the previous full rebuild job is complete successfully.'  
RAISERROR (@error, 16, 1)  
RETURN  
END  
Exec [dbo].[FWP_SCHEDULE_AUDITING] @ScheduleItem = 'SUP_SYNC_DETAIL_TABLES'  
BEGIN TRY  
--Create temp table to keep the changeset from transaction tables  
CREATE TABLE #TimeNewChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #TimeModChange ( PKList bigint, ChangeOperation nchar(1) )  
CREATE TABLE #TimeBilChange ( PKList bigint, ChangeOperation nchar(1) )  
CREATE TABLE #TimeChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #BillAmountChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #DisbNewChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #DisbModChange ( PKList bigint, ChangeOperation nchar(1) )  
CREATE TABLE #DisbBilChange ( PKList bigint, ChangeOperation nchar(1) )  
CREATE TABLE #DisbChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #MatterCreditChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #TrustTransactionChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #PaidFeesChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #PreBillChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #TrmTrustChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #GLJournalChange ( PKList int, ChangeOperation nchar(1) )  
CREATE TABLE #CustomFields (COLUMN_NAME [char](50))  
CREATE TABLE #AR_STATUS (BILLM_UNO int, BILLP_UNO int, BILL_TRAN_UNO int, AR_STATUS varchar(1), ACTION_TYPE nvarchar(10))  
--Get the changeset since last Sync  
INSERT INTO #TimeNewChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'TAT_TIME_NEW',@Schedule = 'SyncDetailTables'  
INSERT INTO #TimeModChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'TAT_TIME_MOD',@Schedule = 'SyncDetailTables'  
INSERT INTO #TimeBilChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'TAT_TIME_BIL',@Schedule = 'SyncDetailTables'  
INSERT INTO #TimeChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'TAT_TIME',@Schedule = 'SyncDetailTables'  
INSERT INTO #BillAmountChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'BLT_BILL_AMT',@Schedule = 'SyncDetailTables'  
INSERT INTO #DisbNewChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'CDT_DISB_NEW',@Schedule = 'SyncDetailTables'  
INSERT INTO #DisbModChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'CDT_DISB_MOD',@Schedule = 'SyncDetailTables'  
INSERT INTO #DisbBilChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'CDT_DISB_BIL',@Schedule = 'SyncDetailTables'  
INSERT INTO #DisbChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'CDT_DISB',@Schedule = 'SyncDetailTables'  
INSERT INTO #MatterCreditChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'ACT_TRAN_CR_MA',@Schedule = 'SyncDetailTables'  
INSERT INTO #TrustTransactionChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'ACT_TRAN_TRUST',@Schedule = 'SyncDetailTables'  
INSERT INTO #PaidFeesChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'BLH_PAID_FEES',@Schedule = 'SyncDetailTables'  
INSERT INTO #PreBillChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'BLT_BILL',@Schedule = 'SyncDetailTables'  
INSERT INTO #TrmTrustChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'TRM_TRUST',@Schedule = 'SyncDetailTables'  
INSERT INTO #GLJournalChange  
EXEC [dbo].[FWP_GET_TABLE_CHANGE] @TableName = 'GLT_JRNL',@Schedule = 'SyncDetailTables'  
--create index for the temp tables  
CREATE CLUSTERED INDEX #TimeNewChange0 ON #TimeNewChange (PKList)  
CREATE CLUSTERED INDEX #TimeModChange0 ON #TimeModChange (PKList)  
CREATE CLUSTERED INDEX #TimeBilChange0 ON #TimeBilChange (PKList)  
CREATE CLUSTERED INDEX #TimeChange0 ON #TimeChange (PKList)  
CREATE CLUSTERED INDEX #BillAmountChange0 ON #BillAmountChange (PKList)  
CREATE CLUSTERED INDEX #DisbNewChange0 ON #DisbNewChange (PKList)  
CREATE CLUSTERED INDEX #DisbModChange0 ON #DisbModChange (PKList)  
CREATE CLUSTERED INDEX #DisbBilChange0 ON #DisbBilChange (PKList)  
CREATE CLUSTERED INDEX #DisbChange0 ON #DisbChange (PKList)  
CREATE CLUSTERED INDEX #MatterCreditChange0 ON #MatterCreditChange (PKList)  
CREATE CLUSTERED INDEX #TrustTransactionChange0 ON #TrustTransactionChange (PKList)  
CREATE CLUSTERED INDEX #PaidFeesChange0 ON #PaidFeesChange (PKList)  
CREATE CLUSTERED INDEX #PreBillChange0 ON #PreBillChange (PKList)  
CREATE CLUSTERED INDEX #TrmTrustChange0 ON #TrmTrustChange (PKList)  
CREATE CLUSTERED INDEX #GLJournalChange0 ON #GLJournalChange (PKList)  
--Merge the TAT_TIME and CDT_DISB changeset since last Sync  
MERGE #TimeNewChange AS T  
USING (SELECT PKList FROM #TimeChange WHERE ChangeOperation = N'U' OR ChangeOperation = N'I') AS S  
ON T.PKList = S.PKList  
WHEN NOT MATCHED THEN  
INSERT (PKList,ChangeOperation)  
VALUES(S.PKList, N'U');  
MERGE #TimeModChange AS T  
USING (SELECT tm.TIME_MOD_UNO FROM #TimeChange t JOIN [dbo].[TAT_TIME_MOD] tm ON tm.TIME_UNO = t.PKList WHERE t.ChangeOperation = N'U' OR t.ChangeOperation = N'I') AS S  
ON T.PKList = S.TIME_MOD_UNO  
WHEN NOT MATCHED THEN  
INSERT (PKList,ChangeOperation)  
VALUES(S.TIME_MOD_UNO, N'U');  
MERGE #TimeBilChange AS T  
USING (SELECT tb.TIME_BIL_UNO FROM #TimeChange t JOIN [dbo].[TAT_TIME_BIL] tb ON tb.TIME_UNO = t.PKList WHERE t.ChangeOperation = N'U' OR t.ChangeOperation = N'I') AS S  
ON T.PKList = S.TIME_BIL_UNO  
WHEN NOT MATCHED THEN  
INSERT (PKList,ChangeOperation)  
VALUES(S.TIME_BIL_UNO, N'U');  
MERGE #DisbNewChange AS T  
USING (SELECT PKList FROM #DisbChange WHERE ChangeOperation = N'U' OR ChangeOperation = N'I') AS S  
ON T.PKList = S.PKList  
WHEN NOT MATCHED THEN  
INSERT (PKList,ChangeOperation)  
VALUES(S.PKList, N'U');  
MERGE #DisbModChange AS T  
USING (SELECT dm.DISB_MOD_UNO FROM #DisbChange d JOIN [dbo].[CDT_DISB_MOD] dm ON dm.DISB_UNO = d.PKList WHERE d.ChangeOperation = N'U' OR d.ChangeOperation = N'I') AS S  
ON T.PKList = S.DISB_MOD_UNO  
WHEN NOT MATCHED THEN  
INSERT (PKList,ChangeOperation)  
VALUES(S.DISB_MOD_UNO, N'U');  
MERGE #DisbBilChange AS T  
USING (SELECT db.DISB_BIL_UNO FROM #DisbChange d JOIN [dbo].[CDT_DISB_BIL] db ON db.DISB_UNO = d.PKList WHERE d.ChangeOperation = N'U' OR d.ChangeOperation = N'I') AS S  
ON T.PKList = S.DISB_BIL_UNO  
WHEN NOT MATCHED THEN  
INSERT (PKList,ChangeOperation)  
VALUES(S.DISB_BIL_UNO, N'U');  
IF NOT EXISTS (select * from sys.sequences where name = 'SUM_DETAIL_SYNC')  
BEGIN  
Exec [Sequence].[CreateSequence] 'SUM_DETAIL_SYNC'  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_BILL_TRANSACTION]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_BILL_TRANSACTION')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_BILL_TRANSACTION'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_BILL_TRANSACTION', @MaxRV  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_DISBURSEMENT]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_DISBURSEMENT')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_DISBURSEMENT'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_DISBURSEMENT', @MaxRV  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_MATTER_CREDIT]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_MATTER_CREDIT')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_MATTER_CREDIT'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_MATTER_CREDIT', @MaxRV  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_PREBILL]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_PREBILL')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_PREBILL'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_PREBILL', @MaxRV  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_TIME]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_TIME')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_TIME'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_TIME', @MaxRV  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_TRUST_TRANSACTION]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_TRUST_TRANSACTION')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_TRUST_TRANSACTION'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_TRUST_TRANSACTION', @MaxRV  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_PAID_FEES]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_PAID_FEES')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_PAID_FEES'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_PAID_FEES', @MaxRV  
END  
Select @MaxRV = max(ROW_VERSION) from [dbo].[SUT_GLJOURNAL_TRANSACTION]  
IF EXISTS (SELECT 1 FROM [dbo].[SUM_DETAIL_SYNC] WHERE TBNAME = 'SUT_GLJOURNAL_TRANSACTION')  
BEGIN  
Update [dbo].[SUM_DETAIL_SYNC] set ROW_VERSION = @MaxRV WHERE TBNAME = 'SUT_GLJOURNAL_TRANSACTION'  
END  
Else  
BEGIN  
Insert into [dbo].[SUM_DETAIL_SYNC](ROW_UNO,TBNAME,ROW_VERSION)  
SELECT NEXT VALUE FOR [Sequence].[SUM_DETAIL_SYNC],'SUT_GLJOURNAL_TRANSACTION', @MaxRV  
END  
-- Load [SUT_TIME] From TAT_TIME_NEW  
IF EXISTS (SELECT TOP 1 PKList FROM #TimeNewChange)  
BEGIN  
--Log TAT_TIME_NEW Changes  
SET @SqlQuery = '  
SELECT  
ct.PKList AS TIME_UNO,  
ct.ChangeOperation,  
''New'' AS ROW_TYPE,  
0 AS TIME_MOD_UNO,  
0 AS TIME_BIL_UNO,  
t.ENTRY_STATUS,  
t.WIP_STATUS,  
tn.MATTER_UNO,  
tn.TK_EMPL_UNO,  
tn.RANK_CODE,  
t.TOBILL_EMPL_UNO,  
t.BILLED_EMPL_UNO,  
t.ACTION_CODE,  
t.LOCATION_CODE,  
tn.TRAN_DATE,  
tn.BASE_HRS,  
tn.TOBILL_HRS,  
0 AS BILLED_HRS,  
tn.BASE_AMT,  
tn.TOBILL_AMT,  
0 AS BILLED_AMT,  
0 AS BILLED_AMT_BILLING,  
tn.STD_AMT,  
t.TAXABLE,  
tn.BILLABLE_FLAG,  
t.BILL_TRAN_UNO,  
tn.CURRENCY_CODE,  
tn.OFFC,  
tn.DEPT,  
tn.PROF,  
tn.DRUNO,  
NULL as BILL_DRUNO,  
t.PHTASK_UNO,  
tn.[PERIOD],  
tn.PROJ,  
t.RETAINED_BILLED_AMT,  
t.RETAINED_BILLED_HRS,  
t.GROSS_AMT,  
t.ADV_PREMDISC_AMT,  
t.CTS_PREMDISC_AMT,  
0 AS BILLED_TOBILL_HRS,  
0 AS BILLED_BASE_AMT,  
0 AS BILLED_TOBILL_AMT,  
CONVERT(INT,LEFT(CONVERT(VARCHAR(10), tn.TRAN_DATE,112),6)) AS TRAN_MONTH,  
0 AS BASE_HRS_TT,  
0 AS TOBILL_HRS_TT,  
0 AS BILLED_HRS_TT,  
0 AS BASE_AMT_TT,  
0 AS TOBILL_AMT_TT,  
0 AS BILLED_AMT_TT,  
0 AS BILLED_AMT_BILLING_TT,  
0 AS STD_AMT_TT'  
--CustomFields  
INSERT INTO #CustomFields  
SELECT DISTINCT c1.[OBJECT_NAME] AS COLUMN_NAME  
FROM [dbo].[DGI_DD_COLCRUTCH] c INNER JOIN [dbo].[DGI_DD_COLCRUTCH] c1 ON c.[OBJECT_NAME] = c1.[OBJECT_NAME]  
WHERE c1.IS_CUSTOM = 'Y' AND c1.TABLE_NAME = 'SUT_TIME' AND c.IS_CUSTOM = 'Y' AND c.TABLE_NAME = 'TAT_TIME_NEW'  
SELECT @CustomFields = @CustomFields + 'tn.'+ QUOTENAME(t.COLUMN_NAME) + ',' FROM (  
SELECT COLUMN_NAME FROM #CustomFields) t  
IF LEN(@CustomFields) > 0 SET @SqlQuery = @SqlQuery + ',' + LEFT(@CustomFields, LEN(@CustomFields)-1)  
SET @SqlQuery = @SqlQuery + '  
INTO #TimeNewLog  
FROM  
#TimeNewChange AS ct  
JOIN [dbo].[TAT_TIME_NEW] AS tn ON ct.PKList = tn.TIME_UNO  
JOIN [dbo].[TAT_TIME] AS t ON tn.TIME_UNO = t.TIME_UNO;'  
SET @SqlQuery = @SqlQuery + '  
CREATE UNIQUE CLUSTERED INDEX #TimeNewLog0  
ON #TimeNewLog (TIME_UNO,ROW_TYPE,TIME_MOD_UNO,TIME_BIL_UNO,ChangeOperation);'  
-- Merge [SUT_TIME]  
SET @SqlQuery = @SqlQuery + '  
MERGE [dbo].[SUT_TIME] AS T  
USING #TimeNewLog AS S  
ON T.TIME_UNO = S.TIME_UNO AND T.ROW_TYPE = S.ROW_TYPE AND T.TIME_MOD_UNO = S.TIME_MOD_UNO AND T.TIME_BIL_UNO = S.TIME_BIL_UNO  
WHEN NOT MATCHED AND S.ChangeOperation = N''I'' THEN  
INSERT (TIME_UNO,ROW_TYPE,TIME_MOD_UNO,TIME_BIL_UNO,ENTRY_STATUS,WIP_STATUS,MATTER_UNO,TK_EMPL_UNO,RANK_CODE,TOBILL_EMPL_UNO,BILLED_EMPL_UNO,ACTION_CODE,LOCATION_CODE,TRAN_DATE,  
BASE_HRS,TOBILL_HRS,BILLED_HRS,BASE_AMT,TOBILL_AMT,BILLED_AMT,BILLED_AMT_BILLING,STD_AMT,TAXABLE,BILLABLE_FLAG,BILL_TRAN_UNO,CURRENCY_CODE,OFFC,DEPT,PROF,DRUNO,BILL_DRUNO,PHTASK_UNO,[PERIOD],PROJ,  
RETAINED_BILLED_AMT,RETAINED_BILLED_HRS,GROSS_AMT,ADV_PREMDISC_AMT,CTS_PREMDISC_AMT,BILLED_TOBILL_HRS,BILLED_BASE_AMT,BILLED_TOBILL_AMT,TRAN_MONTH,BASE_HRS_TT,  
TOBILL_HRS_TT,BILLED_HRS_TT,BASE_AMT_TT,TOBILL_AMT_TT,BILLED_AMT_TT,BILLED_AMT_BILLING_TT,STD_AMT_TT,LAST_MODIFIED'  
IF LEN(@CustomFields) > 0 BEGIN SET @CustomFields = REPLACE(LEFT(@CustomFields, LEN(@CustomFields)-1),'tn.','')  
SET @SqlQuery = @SqlQuery + ','+ @CustomFields + ')' END  
ELSE SET @SqlQuery = @SqlQuery + ')'  
SET @SqlQuery = @SqlQuery + '  
VALUES (S.TIME_UNO,S.ROW_TYPE,S.TIME_MOD_UNO,S.TIME_BIL_UNO,S.ENTRY_STATUS,S.WIP_STATUS,S.MATTER_UNO,S.TK_EMPL_UNO,S.RANK_CODE,S.TOBILL_EMPL_UNO,S.BILLED_EMPL_UNO,S.ACTION_CODE,S.LOCATION_CODE,S.TRAN_DATE,  
S.BASE_HRS,S.TOBILL_HRS,S.BILLED_HRS,S.BASE_AMT,S.TOBILL_AMT,S.BILLED_AMT,S.BILLED_AMT_BILLING,S.STD_AMT,S.TAXABLE,S.BILLABLE_FLAG,S.BILL_TRAN_UNO,S.CURRENCY_CODE,S.OFFC,S.DEPT,S.PROF,S.DRUNO,S.BILL_DRUNO,S.PHTASK_UNO,S.[PERIOD],S.PROJ,  
S.RETAINED_BILLED_AMT,S.RETAINED_BILLED_HRS,S.GROSS_AMT,S.ADV_PREMDISC_AMT,S.CTS_PREMDISC_AMT,S.BILLED_TOBILL_HRS,S.BILLED_BASE_AMT,S.BILLED_TOBILL_AMT,S.TRAN_MONTH,  
S.BASE_HRS_TT,S.TOBILL_HRS_TT,S.BILLED_HRS_TT,S.BASE_AMT_TT,S.TOBILL_AMT_TT,S.BILLED_AMT_TT,S.BILLED_AMT_BILLING_TT,S.STD_AMT_TT,Getdate()'  
IF LEN(@CustomFields) > 0 BEGIN SET @CustomFields = REPLACE(LEFT(@CustomFields, LEN(@CustomFields)),'[','S.[')  
SET @SqlQuery = @SqlQuery + ','+ @CustomFields + ')' END  
ELSE SET @SqlQuery = @SqlQuery + ')'  
SET @SqlQuery = @SqlQuery + '  
WHEN MATCHED AND S.ChangeOperation = N''U'' THEN  
UPDATE  
SET  
ENTRY_STATUS = S.ENTRY_STATUS,  
WIP_STATUS = S.WIP_STATUS,  
MATTER_UNO = S.MATTER_UNO,  
TK_EMPL_UNO = S.TK_EMPL_UNO,  
RANK_CODE = S.RANK_CODE,  
TOBILL_EMPL_UNO = S.TOBILL_EMPL_UNO,  
BILLED_EMPL_UNO = S.BILLED_EMPL_UNO,  
ACTION_CODE = S.ACTION_CODE,  
LOCATION_CODE = S.LOCATION_CODE,  
TRAN_DATE = S.TRAN_DATE,  
BASE_HRS = S.BASE_HRS,  
TOBILL_HRS = S.TOBILL_HRS,  
BASE_AMT = S.BASE_AMT,  
TOBILL_AMT = S.TOBILL_AMT,  
STD_AMT = S.STD_AMT,  
TAXABLE = S.TAXABLE,  
BILLABLE_FLAG = S.BILLABLE_FLAG,  
BILL_TRAN_UNO = S.BILL_TRAN_UNO,  
CURRENCY_CODE = S.CURRENCY_CODE,  
OFFC = S.OFFC,  
DEPT = S.DEPT,  
PROF = S.PROF,  
DRUNO = S.DRUNO,  
BILL_DRUNO = S.BILL_DRUNO,  
PHTASK_UNO = S.PHTASK_UNO,  
[PERIOD] = S.[PERIOD],  
PROJ = S.PROJ,  
RETAINED_BILLED_AMT = S.RETAINED_BILLED_AMT,  
RETAINED_BILLED_HRS = S.RETAINED_BILLED_HRS,  
GROSS_AMT = S.GROSS_AMT,  
ADV_PREMDISC_AMT = S.ADV_PREMDISC_AMT,  
CTS_PREMDISC_AMT = S.CTS_PREMDISC_AMT,  
TRAN_MONTH = S.TRAN_MONTH,  
LAST_MODIFIED = Getdate()'  
IF LEN(@CustomFields) > 0  
BEGIN  
SELECT @CustomFields = STUFF((SELECT ', ' + QUOTENAME(CAST(COLUMN_NAME AS NVARCHAR(MAX))) + '= S.' + QUOTENAME(CAST(COLUMN_NAME AS NVARCHAR(MAX))) [text()]  
FROM #CustomFields  
FOR XML PATH(''), TYPE)  
.value('.','NVARCHAR(MAX)'),1,2,' ')  
SET @SqlQuery = @SqlQuery + ','+ @CustomFields  
END  
SET @SqlQuery = @SqlQuery + ' WHEN MATCHED AND S.ChangeOperation = N''D'' THEN  
DELETE;'  
EXECUTE sp_executesql @sqlQuery  
SELECT @tot_rows = @tot_rows + @@rowcount  
END  
-- Load [SUT_TIME] From TAT_TIME_MOD  
IF EXISTS (SELECT TOP 1 PKList FROM #TimeModChange)  
BEGIN  
--Log TAT_TIME_MOD Changes  
SET @SqlQuery = '  
SELECT  
tm.TIME_UNO,  
''Mod'' AS ROW_TYPE,  
ct.PKList AS TIME_MOD_UNO,  
ct.ChangeOperation,  
0 AS TIME_BIL_UNO,  
t.ENTRY_STATUS,  
t.WIP_STATUS,  
tm.MATTER_UNO,  
tm.TK_EMPL_UNO,  
tm.RANK_CODE,  
t.TOBILL_EMPL_UNO,  
