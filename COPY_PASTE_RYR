SELECT  
    DATEADD(hour, DATEDIFF(hour, GETUTCDATE(), SYSDATETIME()), 
        xevent.value('(event/@timestamp)[1]', 'datetime2')) AS local_time,
    xevent.value('(event/data[@name="scheduler_id"]/value)[1]', 'int') AS scheduler_id,
    xevent.value('(event/data[@name="worker_address"]/value)[1]', 'varchar(50)') AS worker,
    xevent.value('(event/data[@name="process_utilization"]/value)[1]', 'int') AS cpu,
    xevent.value('(event/data[@name="sql_text"]/value)[1]', 'nvarchar(max)') AS sql_text
FROM (
    SELECT CAST(event_data AS XML) AS xevent
    FROM sys.fn_xe_file_target_read_file(
        'system_health*.xel', NULL, NULL, NULL)
) t
WHERE xevent.value('(event/@name)[1]', 'varchar(100)')
    = 'scheduler_monitor_non_yielding_ring_buffer_recorded'
ORDER BY local_time DESC;
