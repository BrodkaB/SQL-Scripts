DECLARE @DBName   SYSNAME = DB_NAME();
DECLARE @RoleName SYSNAME = 'RLL_audit_role';
DECLARE @AuditName SYSNAME = 'MainAudit';

DECLARE @sql NVARCHAR(MAX);

SET @sql = '
CREATE DATABASE AUDIT SPECIFICATION [DB_Audit_Spec]
FOR SERVER AUDIT [' + @AuditName + ']

ADD (FAILED_DATABASE_AUTHENTICATION_GROUP),
ADD (SUCCESSFUL_DATABASE_AUTHENTICATION_GROUP),
ADD (DATABASE_PERMISSION_CHANGE_GROUP),
ADD (DATABASE_OBJECT_PERMISSION_CHANGE_GROUP),
ADD (DATABASE_PRINCIPAL_IMPERSONATION_GROUP),
ADD (DATABASE_PRINCIPAL_CHANGE_GROUP),
ADD (DATABASE_OWNERSHIP_CHANGE_GROUP),
ADD (DATABASE_OBJECT_OWNERSHIP_CHANGE_GROUP),

ADD (DELETE ON DATABASE::[' + @DBName + '] BY [' + @RoleName + ']),
ADD (EXECUTE ON DATABASE::[' + @DBName + '] BY [' + @RoleName + ']),
ADD (INSERT ON DATABASE::[' + @DBName + '] BY [' + @RoleName + ']),
ADD (SELECT ON DATABASE::[' + @DBName + '] BY [' + @RoleName + ']),
ADD (UPDATE ON DATABASE::[' + @DBName + '] BY [' + @RoleName + '])

WITH (STATE = ON)
';

EXEC(@sql);
