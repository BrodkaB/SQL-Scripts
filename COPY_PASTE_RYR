
USE master;
GO

SET NOCOUNT ON;

------------------------------------------------------------
-- CONFIGURATION
------------------------------------------------------------

DECLARE @OldLogin SYSNAME = N'DOMAIN\svc_app_old';
DECLARE @NewLogin SYSNAME = N'DOMAIN\svc_app_new';

DECLARE @IncludeSystemDatabases BIT = 1;
DECLARE @GenerateRepairScripts BIT = 1;

------------------------------------------------------------
-- VALIDATION
------------------------------------------------------------

IF IS_SRVROLEMEMBER('sysadmin') <> 1
BEGIN
    RAISERROR(
        'Run this audit as sysadmin for complete metadata visibility.',
        16, 1
    );
    RETURN;
END;

IF @OldLogin = @NewLogin
BEGIN
    RAISERROR('Old and New login cannot be identical.',16,1);
    RETURN;
END;

DECLARE @OldSID VARBINARY(85);
DECLARE @NewSID VARBINARY(85);

SELECT @OldSID = sid
FROM sys.server_principals
WHERE name = @OldLogin;

SELECT @NewSID = sid
FROM sys.server_principals
WHERE name = @NewLogin;

IF @OldSID IS NULL OR @NewSID IS NULL
BEGIN
    RAISERROR('One or both logins do not exist.',16,1);
    RETURN;
END;

------------------------------------------------------------
-- CLEANUP
------------------------------------------------------------

DROP TABLE IF EXISTS #Inventory;
DROP TABLE IF EXISTS #Comparison;
DROP TABLE IF EXISTS #DBUsers;
DROP TABLE IF EXISTS #DBRoles;
DROP TABLE IF EXISTS #DBPermissions;
DROP TABLE IF EXISTS #DBOwnership;
DROP TABLE IF EXISTS #ServerRoles;
DROP TABLE IF EXISTS #ServerPermissions;
DROP TABLE IF EXISTS #LoginProperties;

------------------------------------------------------------
-- COMMON INVENTORY
------------------------------------------------------------

CREATE TABLE #Inventory
(
    AccountType VARCHAR(3),
    Category VARCHAR(50),
    ScopeName SYSNAME,
    Securable NVARCHAR(1000),
    PermissionName NVARCHAR(256),
    PermissionState NVARCHAR(60),
    Details NVARCHAR(1000),
    RepairDDL NVARCHAR(MAX),
    ReviewRequired BIT DEFAULT 0
);

CREATE TABLE #LoginProperties
(
    AccountType VARCHAR(3),
    LoginName SYSNAME,
    TypeDesc NVARCHAR(60),
    IsDisabled BIT,
    DefaultDatabase SYSNAME,
    DefaultLanguage SYSNAME,
    SID VARBINARY(85),
    IsPolicyChecked BIT,
    IsExpirationChecked BIT
);

CREATE TABLE #ServerRoles
(
    AccountType VARCHAR(3),
    RoleName SYSNAME
);

CREATE TABLE #ServerPermissions
(
    AccountType VARCHAR(3),
    PermissionName SYSNAME,
    StateDesc NVARCHAR(60),
    ClassDesc NVARCHAR(60),
    Securable NVARCHAR(1000),
    RepairDDL NVARCHAR(MAX)
);

CREATE TABLE #DBUsers
(
    AccountType VARCHAR(3),
    DatabaseName SYSNAME,
    UserName SYSNAME,
    TypeDesc NVARCHAR(60),
    AuthenticationTypeDesc NVARCHAR(60),
    DefaultSchema SYSNAME,
    SID VARBINARY(85)
);

CREATE TABLE #DBRoles
(
    AccountType VARCHAR(3),
    DatabaseName SYSNAME,
    UserName SYSNAME,
    RoleName SYSNAME,
    RepairDDL NVARCHAR(MAX)
);

CREATE TABLE #DBPermissions
(
    AccountType VARCHAR(3),
    DatabaseName SYSNAME,
    UserName SYSNAME,
    PermissionName SYSNAME,
    StateDesc NVARCHAR(60),
    ClassDesc NVARCHAR(60),
    Securable NVARCHAR(1000),
    MajorID INT,
    MinorID INT,
    RepairDDL NVARCHAR(MAX),
    ReviewRequired BIT
);

CREATE TABLE #DBOwnership
(
    AccountType VARCHAR(3),
    DatabaseName SYSNAME,
    OwnershipType VARCHAR(30),
    ObjectName NVARCHAR(1000)
);

------------------------------------------------------------
-- 1. LOGIN PROPERTIES
------------------------------------------------------------

INSERT INTO #LoginProperties
SELECT
    CASE WHEN sp.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    sp.name,
    sp.type_desc,
    sp.is_disabled,
    sp.default_database_name,
    sp.default_language_name,
    sp.sid,
    sl.is_policy_checked,
    sl.is_expiration_checked
FROM sys.server_principals sp
LEFT JOIN sys.sql_logins sl
    ON sp.principal_id = sl.principal_id
WHERE sp.sid IN (@OldSID,@NewSID);

------------------------------------------------------------
-- 2. SERVER ROLE MEMBERSHIP
------------------------------------------------------------

INSERT INTO #ServerRoles
SELECT
    CASE WHEN member.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    role.name
FROM sys.server_role_members rm
JOIN sys.server_principals member
    ON rm.member_principal_id = member.principal_id
JOIN sys.server_principals role
    ON rm.role_principal_id = role.principal_id
WHERE member.sid IN (@OldSID,@NewSID);

------------------------------------------------------------
-- 3. SERVER PERMISSIONS
------------------------------------------------------------

INSERT INTO #ServerPermissions
SELECT
    CASE WHEN sp.sid = @OldSID THEN 'OLD' ELSE 'NEW' END,
    p.permission_name,
    p.state_desc,
    p.class_desc,
    CASE
        WHEN p.class_desc = 'SERVER'
            THEN 'SERVER'
        WHEN p.class_desc = 'ENDPOINT'
            THEN ep.name
        ELSE CONVERT(NVARCHAR(1000),p.major_id)
    END,
    CASE
        WHEN p.class_desc = 'SERVER'
        THEN
            p.state_desc + ' ' + p.permission_name +
            ' TO ' + QUOTENAME(
                CASE WHEN sp.sid = @OldSID
                     THEN @NewLogin ELSE @NewLogin END
            )
        WHEN p.class_desc = 'ENDPOINT'
        THEN
            p.state_desc + ' ' + p.permission_name +
            ' ON ENDPOINT::' + QUOTENAME(ep.name) +
            ' TO ' + QUOTENAME(@NewLogin)
        ELSE NULL
    END
FROM sys.server_permissions p
JOIN sys.server_principals sp
    ON p.grantee_principal_id = sp.principal_id
LEFT JOIN sys.endpoints ep
    ON p.class_desc = 'ENDPOINT'
    AND ep.endpoint_id = p.major_id
WHERE sp.sid IN (@OldSID,@NewSID);

------------------------------------------------------------
-- 4. DATABASE COLLECTION
------------------------------------------------------------

DECLARE @DB SYSNAME;
DECLARE @SQL NVARCHAR(MAX);

DECLARE db_cursor CURSOR LOCAL FAST_FORWARD FOR
SELECT name
FROM sys.databases
WHERE state_desc = 'ONLINE'
  AND HAS_DBACCESS(name) = 1
  AND (
      @IncludeSystemDatabases = 1
      OR database_id > 4
  );

OPEN db_cursor;
FETCH NEXT FROM db_cursor INTO @DB;

WHILE @@FETCH_STATUS = 0
BEGIN

    SET @SQL = N'
    USE ' + QUOTENAME(@DB) + N';

    --------------------------------------------------------
    -- DATABASE USERS
    --------------------------------------------------------

    INSERT INTO #DBUsers
    SELECT
        CASE WHEN dp.sid = @OldSID THEN ''OLD'' ELSE ''NEW'' END,
        DB_NAME(),
        dp.name,
        dp.type_desc,
        dp.authentication_type_desc,
        dp.default_schema_name,
        dp.sid
    FROM sys.database_principals dp
    WHERE dp.sid IN (@OldSID,@NewSID)
      AND dp.type IN (''S'',''U'',''G'');

    --------------------------------------------------------
    -- DATABASE ROLE MEMBERSHIP
    --------------------------------------------------------

    INSERT INTO #DBRoles
    SELECT
        CASE WHEN u.AccountType = ''OLD'' THEN ''OLD'' ELSE ''NEW'' END,
        DB_NAME(),
        u.UserName,
        r.name,
        ''ALTER ROLE '' + QUOTENAME(r.name) +
        '' ADD MEMBER '' + QUOTENAME(u.UserName) + '';''

    FROM sys.database_role_members drm
    JOIN sys.database_principals r
        ON drm.role_principal_id = r.principal_id
    JOIN sys.database_principals m
        ON drm.member_principal_id = m.principal_id
    JOIN #DBUsers u
        ON u.DatabaseName = DB_NAME()
        AND u.UserName = m.name
    WHERE u.AccountType IN (''OLD'',''NEW'');

    --------------------------------------------------------
    -- DATABASE PERMISSIONS
    --------------------------------------------------------

    INSERT INTO #DBPermissions
    SELECT
        u.AccountType,
        DB_NAME(),
        u.UserName,
        p.permission_name,
        p.state_desc,
        p.class_desc,

        CASE
            WHEN p.class_desc = ''DATABASE''
                THEN DB_NAME()

            WHEN p.class_desc = ''SCHEMA''
                THEN SCHEMA_NAME(p.major_id)

            WHEN p.class_desc = ''OBJECT_OR_COLUMN''
                THEN
                    QUOTENAME(OBJECT_SCHEMA_NAME(p.major_id))
                    + ''.'' +
                    QUOTENAME(OBJECT_NAME(p.major_id))
                    + CASE
                        WHEN p.minor_id > 0
                        THEN ''.'' + QUOTENAME(
                            COL_NAME(p.major_id,p.minor_id)
                        )
                        ELSE ''''
                      END

            WHEN p.class_desc = ''DATABASE_PRINCIPAL''
                THEN USER_NAME(p.major_id)

            ELSE CONVERT(NVARCHAR(1000),p.major_id)
        END,

        p.major_id,
        p.minor_id,

        CASE
            WHEN p.class_desc = ''DATABASE''
                THEN
                    p.state_desc + '' '' + p.permission_name +
                    '' TO '' + QUOTENAME(
                        CASE WHEN u.AccountType = ''OLD''
                             THEN @NewUserName
                             ELSE u.UserName END
                    )

            WHEN p.class_desc = ''SCHEMA''
                THEN
                    p.state_desc + '' '' + p.permission_name +
                    '' ON SCHEMA::'' +
                    QUOTENAME(SCHEMA_NAME(p.major_id)) +
                    '' TO '' + QUOTENAME(
                        CASE WHEN u.AccountType = ''OLD''
                             THEN @NewUserName
                             ELSE u.UserName END
                    )

            WHEN p.class_desc = ''OBJECT_OR_COLUMN''
                 AND p.minor_id = 0
                THEN
                    p.state_desc + '' '' + p.permission_name +
                    '' ON OBJECT::'' +
                    QUOTENAME(OBJECT_SCHEMA_NAME(p.major_id)) +
                    ''.'' + QUOTENAME(OBJECT_NAME(p.major_id)) +
                    '' TO '' + QUOTENAME(
                        CASE WHEN u.AccountType = ''OLD''
                             THEN @NewUserName
                             ELSE u.UserName END
                    )

            ELSE NULL
        END,

        CASE
            WHEN p.class_desc IN
                (''DATABASE'',''SCHEMA'',''OBJECT_OR_COLUMN'')
                 AND (p.class_desc <> ''OBJECT_OR_COLUMN''
                      OR p.minor_id = 0)
                THEN 0
            ELSE 1
        END

    FROM sys.database_permissions p
    JOIN sys.database_principals grantee
        ON p.grantee_principal_id = grantee.principal_id
    JOIN #DBUsers u
        ON u.DatabaseName = DB_NAME()
        AND u.UserName = grantee.name
    WHERE u.AccountType IN (''OLD'',''NEW'');

    --------------------------------------------------------
    -- SCHEMA OWNERSHIP
    --------------------------------------------------------

    INSERT INTO #DBOwnership
    SELECT
        u.AccountType,
        DB_NAME(),
        ''SCHEMA'',
        s.name
    FROM sys.schemas s
    JOIN sys.database_principals dp
        ON s.principal_id = dp.principal_id
    JOIN #DBUsers u
        ON u.DatabaseName = DB_NAME()
        AND u.UserName = dp.name;

    --------------------------------------------------------
    -- OBJECT OWNERSHIP
    --------------------------------------------------------

    INSERT INTO #DBOwnership
    SELECT
        u.AccountType,
        DB_NAME(),
        ''OBJECT'',
        QUOTENAME(OBJECT_SCHEMA_NAME(o.object_id))
            + ''.'' + QUOTENAME(o.name)
    FROM sys.objects o
    JOIN sys.database_principals dp
        ON o.principal_id = dp.principal_id
    JOIN #DBUsers u
        ON u.DatabaseName = DB_NAME()
        AND u.UserName = dp.name;

    ';

    DECLARE @OldUserName SYSNAME =
        USER_NAME_FROM_SID(@OldSID);

    -- Determine actual database user names from collected metadata.
    -- SID-based lookup is performed inside the database instead.
    SET @SQL = REPLACE(
        @SQL,
        '@NewUserName',
        'REPLACE_PLACEHOLDER'
    );

    -- Replace placeholder with the mapped user name.
    -- The dynamic SQL below uses the database-local name.
    SET @SQL = REPLACE(
        @SQL,
        'REPLACE_PLACEHOLDER',
        'REPLACE_PLACEHOLDER'
    );

    EXEC sys.sp_executesql
        @SQL,
        N'@OldSID VARBINARY(85), @NewSID VARBINARY(85)',
        @OldSID = @OldSID,
        @NewSID = @NewSID;

    FETCH NEXT FROM db_cursor INTO @DB;
END;

CLOSE db_cursor;
DEALLOCATE db_cursor;

------------------------------------------------------------
-- 5. BUILD NORMALIZED INVENTORY
------------------------------------------------------------

INSERT INTO #Inventory
SELECT
    AccountType,
    'LOGIN',
    'SERVER',
    LoginName,
    'LOGIN_CONFIGURATION',
    'CONFIGURATION',
    CONCAT(
        TypeDesc,
        '|Disabled=', IsDisabled,
        '|DefaultDB=', ISNULL(DefaultDatabase,''),
        '|Language=', ISNULL(DefaultLanguage,''),
        '|Policy=', ISNULL(CONVERT(VARCHAR(5),IsPolicyChecked),'NULL'),
        '|Expiration=', ISNULL(CONVERT(VARCHAR(5),IsExpirationChecked),'NULL')
    ),
    NULL,
    0
FROM #LoginProperties;

INSERT INTO #Inventory
SELECT
    AccountType,
    'SERVER_ROLE',
    'SERVER',
    RoleName,
    'MEMBERSHIP',
    'MEMBER',
    RoleName,
    'ALTER SERVER ROLE ' + QUOTENAME(RoleName) +
    ' ADD MEMBER ' + QUOTENAME(@NewLogin) + ';',
    0
FROM #ServerRoles;

INSERT INTO #Inventory
SELECT
    AccountType,
    'SERVER_PERMISSION',
    'SERVER',
    Securable,
    PermissionName,
    StateDesc,
    ClassDesc,
    RepairDDL,
    CASE WHEN RepairDDL IS NULL THEN 1 ELSE 0 END
FROM #ServerPermissions;

INSERT INTO #Inventory
SELECT
