------------------------------------------------------------
-- 8. COMPARISON SUMMARY
------------------------------------------------------------

PRINT '==========================================';
PRINT '9. COMPARISON SUMMARY';
PRINT '==========================================';

SELECT
    Result,
    COUNT(*) AS DifferenceCount
FROM #Comparison
GROUP BY Result
ORDER BY Result;

PRINT '==========================================';
PRINT '10. DIFFERENCE REPORT';
PRINT '==========================================';

SELECT *
FROM #Comparison
WHERE Result <> 'IDENTICAL'
ORDER BY
    Result,
    ScopeName,
    Category,
    Securable;

------------------------------------------------------------
-- 9. REPAIR SCRIPT GENERATION
------------------------------------------------------------

IF @GenerateRepairScripts = 1
BEGIN

    PRINT '==========================================';
    PRINT '11. PROPOSED REPAIR SCRIPTS';
    PRINT 'MANUAL REVIEW REQUIRED';
    PRINT '==========================================';

    SELECT
        Result,
        ScopeName,
        Category,
        Securable,
        RepairDDL
    FROM #Comparison
    WHERE Result = 'MISSING_ON_NEW'
      AND RepairDDL IS NOT NULL
      AND ReviewRequired = 0
    ORDER BY ScopeName,Category,Securable;

END;

------------------------------------------------------------
-- 10. REVIEW REQUIRED
------------------------------------------------------------

PRINT '==========================================';
PRINT '12. MANUAL REVIEW REQUIRED';
PRINT '==========================================';

SELECT *
FROM #Comparison
WHERE ReviewRequired = 1
   OR Result IN ('DIFFERENT','EXTRA_ON_NEW')
ORDER BY ScopeName,Category,Securable;

PRINT '==========================================';
PRINT 'AUDIT FINISHED';
PRINT '==========================================';
