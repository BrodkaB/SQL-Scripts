Get-ChildItem Cert:\LocalMachine\My |
    Select-Object Subject, Thumbprint, HasPrivateKey,
        NotBefore, NotAfter,
        @{Name='DNS'; Expression={
            ($_.DnsNameList | ForEach-Object { $_.Unicode }) -join ', '
        }},
        @{Name='EKU'; Expression={
            ($_.EnhancedKeyUsageList | ForEach-Object { $_.FriendlyName }) -join ', '
        }} |
    Format-List
