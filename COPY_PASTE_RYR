index_name	index_description	index_keys
PK_D996M	nonclustered, unique, primary key located on AUDIT	OPERATOR_ID, SESSION_NO, DATE_R, R_TIME, ENTITY_NO, ENTITY_KEY, DATA_ELEMENT, R_TYPE


SELECT
    c.name AS column_name,
    ic.key_ordinal,
    ic.is_descending_key
FROM sys.indexes i
JOIN sys.index_columns ic
    ON i.object_id = ic.object_id
    AND i.index_id = ic.index_id
JOIN sys.columns c
    ON ic.object_id = c.object_id
    AND ic.column_id = c.column_id
WHERE i.object_id = OBJECT_ID('dbo.D996M')
  AND i.index_id = 2
ORDER BY ic.key_ordinal;

