SELECT
    qs.last_execution_time,
    qs.execution_count,
    st.text AS batch_text,
    qp.query_plan
FROM sys.dm_exec_query_stats AS qs
CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) AS st
OUTER APPLY sys.dm_exec_query_plan(qs.plan_handle) AS qp
WHERE qs.sql_handle IN
(
    0x02000000fba2c206a0af0f8f7bbcce6fbc2ad591be7de19b0000000000000000000000000000000000000000,
    0x02000000ab3d9f34e30c5e21cc7353b56321a6b3f761cfea0000000000000000000000000000000000000000
);
