SELECT
    SYSDATETIME() AS sql_server_local_time,
    SYSDATETIMEOFFSET() AS sql_server_time_with_offset,
    GETDATE() AS getdate_time,
    GETUTCDATE() AS utc_time,
    SYSUTCDATETIME() AS sysutcdatetime_time,
    CURRENT_TIMESTAMP AS current_timestamp_time,
    SYSDATETIMEOFFSET() - SYSUTCDATETIME() AS calculated_offset;
