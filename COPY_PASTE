SELECT
    d.name AS database_name,
    d.recovery_model_desc,
    d.log_reuse_wait_desc,
    ls.total_log_size_mb,
    ls.used_log_space_mb,
    ls.used_log_space_in_percent
FROM sys.databases AS d
CROSS APPLY sys.dm_db_log_space_usage AS ls
WHERE d.database_id > 4
ORDER BY ls.used_log_space_in_percent DESC;


DROP TABLE IF EXISTS #LogUsage;

CREATE TABLE #LogUsage
(
    database_name sysname,
    recovery_model_desc nvarchar(60),
    log_reuse_wait_desc nvarchar(60),
    total_log_size_mb decimal(19,2),
    used_log_space_mb decimal(19,2),
    used_log_space_in_percent decimal(9,2)
);

DECLARE @sql nvarchar(max) = N'';

SELECT @sql += N'
USE ' + QUOTENAME(name) + N';

INSERT INTO #LogUsage
SELECT
    DB_NAME(),
    d.recovery_model_desc,
    d.log_reuse_wait_desc,
    l.total_log_size_in_bytes / 1048576.0,
    l.used_log_space_in_bytes / 1048576.0,
    l.used_log_space_in_percent
FROM sys.databases AS d
CROSS JOIN sys.dm_db_log_space_usage AS l
WHERE d.database_id = DB_ID();'
FROM sys.databases
WHERE database_id > 4
  AND state_desc = 'ONLINE';

EXEC sys.sp_executesql @sql;

SELECT *
FROM #LogUsage
ORDER BY used_log_space_in_percent DESC;


SELECT
    DB_NAME(drs.database_id) AS database_name,
    ar.replica_server_name,
    ar.availability_mode_desc,
    drs.synchronization_state_desc,
    drs.synchronization_health_desc,
    drs.is_suspended,
    drs.log_send_queue_size,
    drs.log_send_rate,
    drs.redo_queue_size,
    drs.redo_rate,
    drs.last_sent_time,
    drs.last_hardened_time,
    drs.last_redone_time
FROM sys.dm_hadr_database_replica_states AS drs
JOIN sys.availability_replicas AS ar
    ON drs.replica_id = ar.replica_id
WHERE drs.is_local = 0
ORDER BY
    database_name,
    ar.replica_server_name;


SELECT
    DB_NAME(database_id) AS database_name,
    synchronization_state_desc,
    synchronization_health_desc,
    is_suspended,
    suspend_reason_desc
FROM sys.dm_hadr_database_replica_states
WHERE is_local = 1;

SQL Server Investigation – Expert Billing, Aderant Appshell Timetrix360 Applications issues

Following several reports from the Billing team regarding applications performance and functionality issues in early and mid-September, an investigation of the SQL Server environment was carried out.

Findings:

SQL Server error logs were reviewed for the reported timestamps, with no relevant errors or abnormalities identified that could explain the reported issues.

No database maintenance activities were running during the reported incidents.

No evidence was found in the reviewed logs to indicate that SQL Server was the root cause of the reported problems.

Additional Context:

In May, a meeting was held with the AAC team to discuss the configuration of our Aderant environment. Given the findings of the current investigation, it may be worth revisiting the environment configuration and considering other potential causes, including application-level issues, network connectivity, or the underlying virtual machine (VM) infrastructure.

Conclusion:

Based on the available evidence, no direct link between the reported incidents and SQL Server has been established. Further investigation involving the application support, network, and infrastructure teams is recommended to identify the root cause.
