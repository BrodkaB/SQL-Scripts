USE DBA;
GO

CREATE TABLE dbo.BAG_Health_Log
(
    HealthID                bigint IDENTITY(1,1) PRIMARY KEY,
    CaptureTime             datetime2 NOT NULL DEFAULT SYSDATETIME(),
    ServerName              sysname NOT NULL,
    AGName                  sysname NOT NULL,
    ReplicaRole             nvarchar(60) NOT NULL,

    SyncState               nvarchar(60) NULL,
    IsSuspended             bit NULL,
    LogSendQueueMB          decimal(18,2) NULL,
    RedoQueueMB             decimal(18,2) NULL,

    LogReuseWaitDesc        nvarchar(120) NULL,

    DataDiskFreePct         decimal(5,2) NULL,
    LogDiskFreePct          decimal(5,2) NULL,

    AgentRunning            bit NOT NULL,
    FailedJobsLastHour      int NOT NULL,

    OverallStatus           varchar(10) NOT NULL, -- GREEN/YELLOW/RED
    ProblemDetails          nvarchar(max) NULL
);
GO
